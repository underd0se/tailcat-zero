#!/bin/sh
# =========================================================================================================================
# TAILCAT ZER0 — Restricted View-Only Diagnostic Shell for Asuswrt-Merlin & Entware
# https://github.com/underd0se/tailcat-zero
# =========================================================================================================================

set -u

# Ensure safe, comprehensive PATH including Entware
export PATH="/opt/bin:/opt/sbin:/bin:/usr/bin:/sbin:/usr/sbin"
export PAGER="cat"

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_CYAN="\033[1;36m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;37m"

print_banner() {
    printf "%b%b========================================================================%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
    printf "  %b%b🐱 TAILCAT ZER0 — View-Only Diagnostic Shell%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
    printf "  WireGuard P2P Encrypted Session • %bRead-Only Diagnostics%b\n" "$C_GREEN" "$C_RESET"
    printf "  (All system writes, file modifications & process kills are blocked)\n"
    printf "%b========================================================================%b\n\n" "$C_CYAN" "$C_RESET"
    printf "  Type %bhelp%b for available tools, %bsysinfo%b for router summary, %bexit%b to quit.\n\n" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET"
}

show_help() {
    printf "%bAvailable Read-Only Diagnostic Commands:%b\n\n" "$C_BOLD" "$C_RESET"

    printf "  %b📊 System Health & Hardware:%b\n" "$C_CYAN" "$C_RESET"
    printf "    uptime, date, free, df, ps, top, uname, dmesg, lsmod\n"
    printf "    sysinfo, cpuinfo, meminfo, temperature\n\n"

    printf "  %b🌐 Network, WiFi & Routing:%b\n" "$C_CYAN" "$C_RESET"
    printf "    ip [addr|route|neigh|link|rule], ifconfig, netstat, route, arp\n"
    printf "    ping, ping6, traceroute, traceroute6, mtr, nslookup, dig, host\n"
    printf "    wl (WiFi stats & clients), ethtool, ethctl, robocfg\n"
    printf "    leases (DHCP clients), wifi, ports\n\n"

    printf "  %b📦 Entware Package Inspection (opkg):%b\n" "$C_CYAN" "$C_RESET"
    printf "    opkg list, opkg list-installed, opkg info <pkg>\n"
    printf "    opkg find <query>, opkg status [pkg], opkg search <file>\n"
    printf "    opkg depends <pkg>, opkg whatdepends <pkg>\n"
    printf "    %b(Note: opkg install/remove/upgrade are blocked)%b\n\n" "$C_GRAY" "$C_RESET"

    printf "  %b📄 Router Config & Logs:%b\n" "$C_CYAN" "$C_RESET"
    printf "    nvram get <key>, nvram show (nvram set/commit blocked)\n"
    printf "    logread, logread -f (live stream), logs\n\n"

    printf "  %b🔍 Text & File Inspection:%b\n" "$C_CYAN" "$C_RESET"
    printf "    cat, head, tail (tail -f), more, less, grep, egrep, fgrep, rg\n"
    printf "    tree, ls, dir, du, wc, sort, uniq, cut, column, tr, diff\n"
    printf "    strings, stat, file, hexdump, xxd, locate, which, whereis\n\n"

    printf "  %b⚡ Pipelines:%b\n" "$C_CYAN" "$C_RESET"
    printf "    Pipes (|) between allowed commands are supported (e.g. ps | grep tailcat)\n"
    printf "    File redirections (>, >>, <) and command chaining (; && ||) are blocked.\n\n"
}

show_sysinfo() {
    model=$(nvram get model 2>/dev/null || echo "Unknown Router")
    buildno=$(nvram get buildno 2>/dev/null || echo "Unknown")
    extendno=$(nvram get extendno 2>/dev/null || echo "")
    wan_ip=$(nvram get wan0_ipaddr 2>/dev/null || echo "N/A")
    wan_proto=$(nvram get wan0_proto 2>/dev/null || echo "N/A")
    lan_ip=$(nvram get lan_ipaddr 2>/dev/null || echo "N/A")

    printf "\n%b%b--- Router System Summary ---%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
    printf "  %bModel:%b        %s (Firmware: %s_%s)\n" "$C_BOLD" "$C_RESET" "$model" "$buildno" "$extendno"
    printf "  %bUptime:%b       %s\n" "$C_BOLD" "$C_RESET" "$(uptime | sed 's/^[ \t]*//')"
    printf "  %bWAN IP:%b       %s (Protocol: %s)\n" "$C_BOLD" "$C_RESET" "$wan_ip" "$wan_proto"
    printf "  %bLAN IP:%b       %s\n" "$C_BOLD" "$C_RESET" "$lan_ip"

    if [ -f "/proc/dmu/temperature" ]; then
        temp_val=$(cat /proc/dmu/temperature 2>/dev/null || echo "")
        [ -n "$temp_val" ] && printf "  %bTemperature:%b %s\n" "$C_BOLD" "$C_RESET" "$temp_val"
    fi

    printf "  %bMemory:%b\n" "$C_BOLD" "$C_RESET"
    free -h 2>/dev/null || free -m 2>/dev/null || free
    printf "\n  %bStorage:%b\n" "$C_BOLD" "$C_RESET"
    df -h /jffs /tmp 2>/dev/null || df -h
    printf "%b----------------------------%b\n\n" "$C_CYAN" "$C_RESET"
}

show_leases() {
    printf "\n%bActive DHCP Leases (/tmp/dnsmasq.leases):%b\n\n" "$C_BOLD" "$C_RESET"
    if [ -s "/tmp/dnsmasq.leases" ]; then
        printf "%b%-16s %-18s %-25s %s%b\n" "$C_CYAN" "IP Address" "MAC Address" "Hostname" "Client ID" "$C_RESET"
        printf "%s\n" "────────────────────────────────────────────────────────────────────────"
        awk '{printf "%-16s %-18s %-25s %s\n", $3, $2, ($4=="*"?"<unnamed>":$4), $5}' /tmp/dnsmasq.leases
        printf "\n"
    else
        printf "  No active DHCP leases found.\n\n"
    fi
}

show_wifi() {
    printf "\n%bWireless Radio & Connected Clients:%b\n\n" "$C_BOLD" "$C_RESET"
    for iface in eth6 eth7 wl0 wl1; do
        if command -v wl >/dev/null 2>&1 && wl -i "$iface" isup 2>/dev/null | grep -q "1"; then
            ssid=$(wl -i "$iface" ssid 2>/dev/null | sed 's/^Current SSID: //' || echo "N/A")
            chanspec=$(wl -i "$iface" chanspec 2>/dev/null || echo "N/A")
            client_cnt=$(wl -i "$iface" assoclist 2>/dev/null | wc -l | tr -d ' ' || echo "0")
            printf "  • %bInterface %s:%b SSID: %b%s%b (Channel: %s) • Clients: %b%s%b\n" "$C_BOLD" "$iface" "$C_RESET" "$C_CYAN" "$ssid" "$C_RESET" "$chanspec" "$C_GREEN" "$client_cnt" "$C_RESET"
        fi
    done
    printf "\n"
}

show_ports() {
    printf "\n%bActive Listening Services (TCP & UDP):%b\n\n" "$C_BOLD" "$C_RESET"
    netstat -tlpn 2>/dev/null || netstat -an 2>/dev/null
    printf "\n"
}

# -------------------------------------------------------------------------------------------------------------------------
# Command Validation Engine

validate_and_run() {
    raw_input="$1"

    # Trim leading/trailing whitespace
    clean_input=$(echo "$raw_input" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$clean_input" ] && return 0

    # 1. Block dangerous redirection & subshell syntax
    case "$clean_input" in
        *">"*|*"<"*)
            printf "%b[!] Security Error: File redirection (>, >>, <) is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
        *"\`"*|*"\$("*)
            printf "%b[!] Security Error: Subshell execution (\` \`, \$( )) is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
        *";"*|*"&&"*|*"||"*)
            printf "%b[!] Security Error: Command chaining (; && ||) is prohibited. Use pipelines (|) with allowed tools.%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
    esac

    # 2. Check built-ins
    case "$clean_input" in
        help|h|\?)
            show_help
            return 0
            ;;
        sysinfo)
            show_sysinfo
            return 0
            ;;
        leases|dhcp-leases)
            show_leases
            return 0
            ;;
        wifi)
            show_wifi
            return 0
            ;;
        ports)
            show_ports
            return 0
            ;;
        logs)
            logread 2>/dev/null | tail -n 50
            return 0
            ;;
        clear)
            printf "\033[2J\033[H"
            return 0
            ;;
        exit|quit|q)
            printf "\n%bSession disconnected.%b\n" "$C_CYAN" "$C_RESET"
            exit 0
            ;;
    esac

    # 3. Validate each pipeline stage
    saved_ifs="$IFS"
    IFS="|"
    for stage in $clean_input; do
        IFS="$saved_ifs"
        stage=$(echo "$stage" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        if [ -z "$stage" ]; then
            printf "%b[!] Syntax Error: Empty pipeline stage.%b\n" "$C_RED" "$C_RESET"
            return 1
        fi

        cmd_token=$(echo "$stage" | awk '{print $1}')
        base_cmd=$(basename "$cmd_token")
        sub_arg=$(echo "$stage" | awk '{print $2}')

        case "$base_cmd" in
            uptime|date|free|df|ps|top|uname|dmesg|sysinfo|cpuinfo|meminfo|temperature|lsmod|\
            netstat|route|arp|ping|ping6|traceroute|traceroute6|mtr|nslookup|dig|host|wl|ethtool|\
            mii-tool|ethctl|robocfg|leases|dhcp-leases|wifi|ports|logs|help|exit|quit|clear|\
            cat|head|tail|more|less|grep|egrep|fgrep|rg|tree|ls|dir|vdir|du|wc|sort|uniq|cut|column|\
            tr|diff|strings|stat|file|hexdump|xxd|locate|which|whereis|echo|printf|env|who|w|id)
                ;;
            nvram)
                case "$sub_arg" in
                    get|show)
                        ;;
                    *)
                        printf "%b[!] Security Error: 'nvram %s' is blocked. Only 'nvram get' and 'nvram show' are permitted in view-only mode.%b\n" "$C_RED" "${sub_arg:-<empty>}" "$C_RESET"
                        return 1
                        ;;
                esac
                ;;
            opkg)
                case "$sub_arg" in
                    list|list-installed|info|find|status|search|depends|whatdepends)
                        ;;
                    *)
                        printf "%b[!] Security Error: 'opkg %s' is blocked. Only read-only package queries (list, info, find, status) are permitted.%b\n" "$C_RED" "${sub_arg:-<empty>}" "$C_RESET"
                        return 1
                        ;;
                esac
                ;;
            ip)
                case "$sub_arg" in
                    addr|route|neigh|link|rule|a|r|l)
                        case "$stage" in
                            *" add "*|*" del "*|*" delete "*|*" change "*|*" replace "*|*" set "*)
                                printf "%b[!] Security Error: 'ip' write/modify operations are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                                return 1
                                ;;
                        esac
                        ;;
                    *)
                        printf "%b[!] Security Error: 'ip %s' is blocked. Only inspection verbs (addr, route, neigh, link, rule) are permitted.%b\n" "$C_RED" "${sub_arg:-<empty>}" "$C_RESET"
                        return 1
                        ;;
                esac
                ;;
            ifconfig)
                case "$stage" in
                    *" up"*|*" down"*|*" netmask "*|*" broadcast "*)
                        printf "%b[!] Security Error: 'ifconfig' modification operations are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                        return 1
                        ;;
                esac
                ;;
            logread)
                ;;
            *)
                printf "%b[!] Security Error: Command '%s' is not permitted in view-only mode.%b\n" "$C_RED" "$base_cmd" "$C_RESET"
                printf "    Type 'help' to see the list of allowed diagnostic tools.\n"
                return 1
                ;;
        esac
    done
    IFS="$saved_ifs"

    # 4. Execute validated pipeline
    eval "$clean_input"
    return $?
}

# -------------------------------------------------------------------------------------------------------------------------
# Execution Mode Dispatcher

# Non-interactive command invocation (-c "<command>")
if [ "${1:-}" = "-c" ]; then
    shift
    cmd_to_run="$*"
    validate_and_run "$cmd_to_run"
    exit $?
fi

# Interactive Login Session
print_banner

while true; do
    printf "%btailcatzero-view:~$ %b" "$C_GREEN" "$C_RESET"
    if ! read -r user_cmd; then
        printf "\n%bSession closed.%b\n" "$C_CYAN" "$C_RESET"
        exit 0
    fi
    validate_and_run "$user_cmd" || true
done
