#!/bin/sh
# =========================================================================================================================
# TAILCAT ZER0 — View-Only Diagnostic Shell Architecture Dispatcher
# Automatically executes the appropriate precompiled static Musl / native C99 binary
# =========================================================================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ARCH="$(uname -m 2>/dev/null || echo "")"
TARGET=""

case "$ARCH" in
    armv7*|armv6*|arm) TARGET="armv7" ;;
    aarch64*|arm64*)  TARGET="arm64" ;;
    x86_64*|amd64*)   TARGET="amd64" ;;
    *) TARGET="" ;;
esac

# 1. Check for native host binary (built via make native / build.sh)
if [ -x "${SCRIPT_DIR}/bin/tailcat-view-shell-native" ]; then
    exec "${SCRIPT_DIR}/bin/tailcat-view-shell-native" "$@"
fi

# 2. Check for architecture-specific static Musl binary
if [ -n "$TARGET" ] && [ -x "${SCRIPT_DIR}/bin/tailcat-view-shell-${TARGET}" ]; then
    exec "${SCRIPT_DIR}/bin/tailcat-view-shell-${TARGET}" "$@"
fi

# 3. Auto-compile native host binary if compiler is available
if command -v zig >/dev/null 2>&1 || command -v cc >/dev/null 2>&1; then
    mkdir -p "${SCRIPT_DIR}/bin"
    if [ -x "${SCRIPT_DIR}/build.sh" ]; then
        "${SCRIPT_DIR}/build.sh" native "${SCRIPT_DIR}/bin/tailcat-view-shell-native" >/dev/null 2>&1 && \
        exec "${SCRIPT_DIR}/bin/tailcat-view-shell-native" "$@"
    fi
fi

printf "tailcat-view-shell: No compatible compiled binary found for architecture '%s'.\nPlease run 'make musl' or './build.sh all'.\n" "$ARCH" >&2
exit 1
