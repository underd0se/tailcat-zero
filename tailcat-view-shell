#!/bin/sh
# =========================================================================================================================
# TAILCAT ZER0 — Restricted View-Only Diagnostic Shell for Asuswrt-Merlin & Entware
# https://github.com/underd0se/tailcat-zero
# =========================================================================================================================

set -u

# Ensure safe, comprehensive PATH including Entware
export PATH="/opt/bin:/opt/sbin:/bin:/usr/bin:/sbin:/usr/sbin"

# Neutralize interactive pagers & shell escapes (GTFOBins)
export PAGER="cat"
export LESSSECURE=1
export LESS="-M -R"

# Function wrappers to stream pagers non-interactively
safe_stream() {
    _stream_args=""
    for _arg in "$@"; do
        case "$_arg" in
            -*) ;;
            +*) ;;
            *) _stream_args="${_stream_args} \"$_arg\"" ;;
        esac
    done
    if [ -z "$_stream_args" ]; then
        cat
    else
        eval "cat $_stream_args"
    fi
}
less() { safe_stream "$@"; }
more() { safe_stream "$@"; }

# IPC File Paths for On-Demand Permission Escalation
SESSIONS_DIR="/tmp/tailcat_sessions"
REQUESTS_DIR="${SESSIONS_DIR}/requests"
APPROVED_FILE="${SESSIONS_DIR}/VIEW_APPROVED.txt"
DENIED_FILE="${SESSIONS_DIR}/VIEW_DENIED.txt"
VIEW_ONCE_DIR="${SESSIONS_DIR}/VIEW_ONCE"
ONCE_DIR="$VIEW_ONCE_DIR"
ACTIVE_TUIS_DIR="${SESSIONS_DIR}/active_tuis"

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_CYAN="\033[1;36m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;37m"

print_banner() {
    printf "%b%b========================================================================%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
    printf "  %b%b🐱 TAILCAT ZER0 — View-Only Diagnostic Shell%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
    printf "  WireGuard P2P Encrypted Session • %bRead-Only Diagnostics%b\n" "$C_GREEN" "$C_RESET"
    printf "  (All system writes, file modifications & process kills are blocked)\n"
    printf "%b========================================================================%b\n\n" "$C_CYAN" "$C_RESET"
    printf "  Type %bhelp%b for tools, %bsysinfo%b for status, %brequest <cmd>%b for approval.\n\n" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET"
}

show_help() {
    printf "  %bAvailable Read-Only Diagnostic Commands:%b\n\n" "$C_BOLD" "$C_RESET"

    printf "  %b📊 System Health & Hardware:%b\n" "$C_CYAN" "$C_RESET"
    printf "    uptime, date, free, df, ps, top, uname, dmesg, lsmod\n"
    printf "    sysinfo, cpuinfo, meminfo, temperature\n\n"

    printf "  %b🌐 Network, WiFi & Routing:%b\n" "$C_CYAN" "$C_RESET"
    printf "    ip [addr|route|neigh|link|rule], ifconfig, netstat, route, arp\n"
    printf "    ping, ping6, traceroute, traceroute6, mtr, nslookup, dig, host\n"
    printf "    wl (WiFi stats & clients), ethtool, ethctl, robocfg\n"
    printf "    leases (DHCP clients), wifi, ports\n\n"

    printf "  %b📦 Entware Package Inspection (opkg):%b\n" "$C_CYAN" "$C_RESET"
    printf "    opkg list, opkg list-installed, opkg info <pkg>\n"
    printf "    opkg find <query>, opkg status [pkg], opkg search <file>\n"
    printf "    opkg depends <pkg>, opkg whatdepends <pkg>\n"
    printf "    %b(Note: opkg install/remove/upgrade are blocked)%b\n\n" "$C_GRAY" "$C_RESET"

    printf "  %b📄 Router Config & Logs:%b\n" "$C_CYAN" "$C_RESET"
    printf "    nvram get <key> (credential keys blocked), logread, logread -f, logs\n\n"

    printf "  %b🔍 Text & File Inspection:%b\n" "$C_CYAN" "$C_RESET"
    printf "    cat, head, tail (tail -f), more, less, grep, egrep, fgrep, rg\n"
    printf "    tree, ls, dir, du, wc, sort, uniq, cut, column, tr, diff\n"
    printf "    strings, stat, file, hexdump, locate, which, whereis\n\n"

    printf "  %b⚡ Pipelines:%b\n" "$C_CYAN" "$C_RESET"
    printf "    Pipes (|) between allowed commands are supported (e.g. ps | grep tailcat)\n"
    printf "    File redirections (>, >>, <) and command chaining (; && ||) are blocked.\n\n"

    printf "  %b🔔 On-Demand Permission Escalation:%b\n" "$C_CYAN" "$C_RESET"
    printf "    request <cmd> (e.g. request tcpdump -i eth0)\n"
    printf "    Submits a real-time request to the router host for approval.\n"
    printf "    Host can approve for the entire session or for a single run.\n\n"
}

show_sysinfo() {
    model=$(nvram get model 2>/dev/null || echo "Unknown Router")
    buildno=$(nvram get buildno 2>/dev/null || echo "Unknown")
    extendno=$(nvram get extendno 2>/dev/null || echo "")
    wan_ip=$(nvram get wan0_ipaddr 2>/dev/null || echo "N/A")
    wan_proto=$(nvram get wan0_proto 2>/dev/null || echo "N/A")
    lan_ip=$(nvram get lan_ipaddr 2>/dev/null || echo "N/A")

    printf "\n%b%b--- Router System Summary ---%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
    printf "  %bModel:%b        %s (Firmware: %s_%s)\n" "$C_BOLD" "$C_RESET" "$model" "$buildno" "$extendno"
    printf "  %bUptime:%b       %s\n" "$C_BOLD" "$C_RESET" "$(uptime | sed 's/^[ \t]*//')"
    printf "  %bWAN IP:%b       %s (Protocol: %s)\n" "$C_BOLD" "$C_RESET" "$wan_ip" "$wan_proto"
    printf "  %bLAN IP:%b       %s\n" "$C_BOLD" "$C_RESET" "$lan_ip"

    if [ -f "/proc/dmu/temperature" ]; then
        temp_val=$(cat /proc/dmu/temperature 2>/dev/null || echo "")
        [ -n "$temp_val" ] && printf "  %bTemperature:%b %s\n" "$C_BOLD" "$C_RESET" "$temp_val"
    fi

    printf "  %bMemory:%b\n" "$C_BOLD" "$C_RESET"
    free -h 2>/dev/null || free -m 2>/dev/null || free
    printf "\n  %bStorage:%b\n" "$C_BOLD" "$C_RESET"
    df -h /jffs /tmp 2>/dev/null || df -h
    printf "%b----------------------------%b\n\n" "$C_CYAN" "$C_RESET"
}

show_leases() {
    printf "\n%bActive DHCP Leases (/tmp/dnsmasq.leases):%b\n\n" "$C_BOLD" "$C_RESET"
    if [ -s "/tmp/dnsmasq.leases" ]; then
        printf "%b%-16s %-18s %-25s %s%b\n" "$C_CYAN" "IP Address" "MAC Address" "Hostname" "Client ID" "$C_RESET"
        printf "%s\n" "────────────────────────────────────────────────────────────────────────"
        awk '{printf "%-16s %-18s %-25s %s\n", $3, $2, ($4=="*"?"<unnamed>":$4), $5}' /tmp/dnsmasq.leases
        printf "\n"
    else
        printf "  No active DHCP leases found.\n\n"
    fi
}

show_wifi() {
    printf "\n%bWireless Radio & Connected Clients:%b\n\n" "$C_BOLD" "$C_RESET"
    for iface in eth6 eth7 wl0 wl1; do
        if command -v wl >/dev/null 2>&1 && wl -i "$iface" isup 2>/dev/null | grep -q "1"; then
            ssid=$(wl -i "$iface" ssid 2>/dev/null | sed 's/^Current SSID: //' || echo "N/A")
            chanspec=$(wl -i "$iface" chanspec 2>/dev/null || echo "N/A")
            client_cnt=$(wl -i "$iface" assoclist 2>/dev/null | wc -l | tr -d ' ' || echo "0")
            printf "  • %bInterface %s:%b SSID: %b%s%b (Channel: %s) • Clients: %b%s%b\n" "$C_BOLD" "$iface" "$C_RESET" "$C_CYAN" "$ssid" "$C_RESET" "$chanspec" "$C_GREEN" "$client_cnt" "$C_RESET"
        fi
    done
    printf "\n"
}

show_ports() {
    printf "\n%bActive Listening Services (TCP & UDP):%b\n\n" "$C_BOLD" "$C_RESET"
    netstat -tlpn 2>/dev/null || netstat -an 2>/dev/null
    printf "\n"
}

# -------------------------------------------------------------------------------------------------------------------------
# Permission Escalation Helpers

is_cmd_approved() {
    target_bcmd="$1"
    # 1. Session-wide approval
    if [ -f "$APPROVED_FILE" ] && grep -Fxq "$target_bcmd" "$APPROVED_FILE" 2>/dev/null; then
        return 0
    fi
    # 2. Single-use approval
    once_token="${ONCE_DIR}/${target_bcmd}.token"
    if [ -f "$once_token" ]; then
        rm -f "$once_token" 2>/dev/null || true
        return 0
    fi
    return 1
}

is_cmd_denied() {
    target_bcmd="$1"
    if [ -f "$DENIED_FILE" ] && grep -Fxq "$target_bcmd" "$DENIED_FILE" 2>/dev/null; then
        return 0
    fi
    return 1
}

is_gtfobin() {
    case "$1" in
        awk|gawk|mawk|nawk|find|python|python2|python3|perl|lua|ruby|php|\
        vim|vi|nano|ed|sed|tar|zip|unzip|gzip|bzip2|cp|mv|rm|dd|chmod|chown|\
        sh|bash|ash|zsh|dash|ksh|busybox|env|xargs|tee|curl|wget|nc|netcat|socat)
            return 0
            ;;
    esac
    return 1
}

check_sensitive_target() {
    _p="$1"
    case "$_p" in
        "/dev/null")
            return 1
            ;;
        *"/dev/null"*)
            _p_nonull=$(printf "%s" "$_p" | sed -e 's|/dev/null||g')
            case "$_p_nonull" in
                *"/dev/"*) return 0 ;;
            esac
            ;;
        *"/dev/"*)
            return 0
            ;;
    esac
    case "$_p" in
        *"shadow"*|*"passwd"*|*"etc/sha"*|*"etc/pas"*|*".ssh"*|*"dropbear"*|*"/openvpn"*|*"openvpn/"*|*".key"*|\
        *"/jffs/ssl/"*|*"/jffs/.sys"*|*"tailcat_sessions"*|*"tailcat_addr"*|*"authorized_keys"*|\
        *"id_"*|*".crt"*|*".pem"*|*".pfx"*|*".p12"*|*".der"*|*"/nvram"*|*"nvram.nvm"*|\
        *"tailcatzero.cfg"*|*"tailcat.cfg"*|*"/addons/tailcat"*|*"/proc/kcore"*|*"/proc/kmsg"*|*"/proc/kallsyms"*|\
        *"/proc/keys"*|*"/proc/key-users"*|*"wireguard"*|*"/wg"*|*".ovpn"*)
            return 0
            ;;
    esac
    return 1
}

is_sensitive_file_access() {
    _stage="$1"
    # 1. Direct check on stage string
    if check_sensitive_target "$_stage"; then
        return 0
    fi
    # 2. Check each token, direct symlink, and any filesystem glob expansion
    for _tok in $_stage; do
        if check_sensitive_target "$_tok"; then
            return 0
        fi
        if [ -L "$_tok" ]; then
            _link_target=$(readlink "$_tok" 2>/dev/null || true)
            if [ -n "$_link_target" ] && check_sensitive_target "$_link_target"; then
                return 0
            fi
            _canon_target=$(readlink -f "$_tok" 2>/dev/null || true)
            if [ -n "$_canon_target" ] && check_sensitive_target "$_canon_target"; then
                return 0
            fi
        fi
        case "$_tok" in
            *"*"*|*"?"*|*"["*)
                for _exp in $_tok; do
                    if [ -e "$_exp" ] || [ -L "$_exp" ]; then
                        if check_sensitive_target "$_exp"; then
                            return 0
                        fi
                        if [ -L "$_exp" ]; then
                            _link_target=$(readlink "$_exp" 2>/dev/null || true)
                            if [ -n "$_link_target" ] && check_sensitive_target "$_link_target"; then
                                return 0
                            fi
                            _canon_target=$(readlink -f "$_exp" 2>/dev/null || true)
                            if [ -n "$_canon_target" ] && check_sensitive_target "$_canon_target"; then
                                return 0
                            fi
                        fi
                    fi
                done
                ;;
        esac
    done
    return 1
}

request_command_approval() {
    req_input="$1"
    req_base="$2"

    # Canonicalize request before inspecting red lines to defeat quote/backslash evasion
    req_input_canon=$(printf "%s" "$req_input" | sed -e 's/\\//g' -e 's/"//g' -e "s/'//g" | tr '\t' ' ' | sed -e 's/[[:space:]][[:space:]]*/ /g' -e 's/^ //' -e 's/ $//')

    # Red lines check: permanent block on partition / flash destruction
    case "$req_input_canon" in
        *"/dev/mtd"*|*"/dev/nvram"*|*"/dev/mem"*|*"/dev/kmem"*|*"rm -rf /"*|*"nvram erase"*|*"mtd "*|*"mtd-"*|*"flash_erase"*|*"flashcp"*|*"nandwrite"*)
            printf "%b[!] Security Error: Destructive hardware / partition operations cannot be requested.%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
    esac

    # Sensitive files check: cannot request access to passwords, shadow, keys, certificates
    if is_sensitive_file_access "$req_input_canon"; then
        printf "%b[!] Security Error: Requests targeting sensitive system security files are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
        return 1
    fi

    mkdir -p "$REQUESTS_DIR" "$VIEW_ONCE_DIR"
    chmod 700 "$SESSIONS_DIR" "$REQUESTS_DIR" "$VIEW_ONCE_DIR" 2>/dev/null || true
    req_id="req_$(date +%s)_$$"
    req_file="${REQUESTS_DIR}/${req_id}.req"
    resp_file="${REQUESTS_DIR}/${req_id}.resp"

    req_input_escaped=$(printf "%s" "$req_input" | tr '\r\n' ' ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    req_base_clean=$(printf "%s" "$req_base" | tr -cd 'a-zA-Z0-9_.-')

    is_gtfo="NO"
    if is_gtfobin "$req_base_clean"; then
        is_gtfo="YES"
    fi

    {
        echo "REQ_ID=\"${req_id}\""
        echo "GUEST_PID=\"$$\""
        echo "BASE_CMD=\"${req_base_clean}\""
        echo "RAW_COMMAND=\"${req_input_escaped}\""
        echo "CREATED_AT=\"$(date +%s)\""
        echo "IS_GTFOBIN=\"${is_gtfo}\""
        echo "STATUS=\"PENDING\""
    } > "$req_file"

    logger -t tailcatzero "GUEST PERMISSION REQUEST: '${req_base_clean}' ('${req_input}') [ID: ${req_id}] GTFO=${is_gtfo}"

    # Notify ONLY active tailcatzero TUI dashboard screen(s)
    # Sanitize input before writing to admin TTY to prevent ANSI terminal escape injection
    tty_safe_input=$(printf "%s" "$req_input" | tr -cd 'a-zA-Z0-9 _./:=+-' | cut -c 1-80)
    cur_tty=""
    if [ -t 0 ]; then
        cur_tty=$(tty 2>/dev/null || true)
    fi
    if [ -d "$ACTIVE_TUIS_DIR" ]; then
        for f in "${ACTIVE_TUIS_DIR}"/*; do
            [ -f "$f" ] || continue
            t_pid=$(basename "$f")
            if kill -0 "$t_pid" 2>/dev/null; then
                target_tty=$(cat "$f" 2>/dev/null || true)
                if [ -n "$target_tty" ] && [ "$target_tty" != "$cur_tty" ] && [ -w "$target_tty" ]; then
                    if [ "$is_gtfo" = "YES" ]; then
                        printf "\n\033[1;31m[tailcatzero] ⚠️  Guest requested elevated execution tool: '%s' (ID: %s)\033[0m\n\033[1;36mPress [P] to review or run 'tailcatzero approve'\033[0m\n" "$tty_safe_input" "$req_id" > "$target_tty" 2>/dev/null || true
                    else
                        printf "\n\033[1;33m[tailcatzero] 🔔 Guest requested permission to run: '%s' (ID: %s)\033[0m\n\033[1;36mPress [P] to review or run 'tailcatzero approve'\033[0m\n" "$tty_safe_input" "$req_id" > "$target_tty" 2>/dev/null || true
                    fi
                fi
            else
                rm -f "$f" 2>/dev/null || true
            fi
        done
    fi

    printf "\n%b[*] Permission request submitted to router host:%b\n" "$C_CYAN" "$C_RESET"
    printf "    Command: %b%s%b (Tool: %b%s%b)\n" "$C_YELLOW" "$req_input" "$C_RESET" "$C_BOLD" "$req_base_clean" "$C_RESET"
    if [ "$is_gtfo" = "YES" ]; then
        printf "    %b⚠️  Notice: '%s' has execution or file modification capabilities.%b\n" "$C_YELLOW" "$req_base_clean" "$C_RESET"
    fi
    printf "    ID:      %s\n" "$req_id"
    printf "%b[*] Waiting for host approval (timeout: 60s)...%b " "$C_GRAY" "$C_RESET"

    waited=0
    resp_status=""
    while [ "$waited" -lt 60 ]; do
        if [ -f "$resp_file" ]; then
            resp_status=$(grep '^STATUS=' "$resp_file" 2>/dev/null | head -n 1 | cut -d'=' -f2- | tr -d '"\r\n' || true)
            break
        fi
        sleep 1
        waited=$((waited + 1))
        if [ $((waited % 5)) -eq 0 ]; then
            printf "."
        fi
    done
    printf "\n"

    rm -f "$req_file" "$resp_file" 2>/dev/null || true

    case "$resp_status" in
        APPROVED_SESSION)
            printf "%b[+] Host APPROVED '%s' for this session! Running command...%b\n\n" "$C_GREEN" "$req_base_clean" "$C_RESET"
            if [ -f "$DENIED_FILE" ]; then
                grep -Fxv "$req_base_clean" "$DENIED_FILE" > "${DENIED_FILE}.tmp" 2>/dev/null || true
                mv -f "${DENIED_FILE}.tmp" "$DENIED_FILE" 2>/dev/null || true
            fi
            if ! grep -Fxq "$req_base_clean" "$APPROVED_FILE" 2>/dev/null; then
                echo "$req_base_clean" >> "$APPROVED_FILE"
            fi
            rm -f "${ONCE_DIR}/${req_base_clean}.token" 2>/dev/null || true
            eval "$req_input"
            return $?
            ;;
        APPROVED_ONCE)
            printf "%b[+] Host APPROVED single execution! Running command...%b\n\n" "$C_GREEN" "$C_RESET"
            rm -f "${ONCE_DIR}/${req_base_clean}.token" 2>/dev/null || true
            eval "$req_input"
            return $?
            ;;
        DENIED)
            printf "%b[-] Host DENIED permission for '%s'.%b\n" "$C_RED" "$req_base_clean" "$C_RESET"
            if ! grep -Fxq "$req_base_clean" "$DENIED_FILE" 2>/dev/null; then
                echo "$req_base_clean" >> "$DENIED_FILE"
            fi
            return 1
            ;;
        *)
            printf "%b[!] Request timed out (host did not respond within 60s).%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
    esac
}

# -------------------------------------------------------------------------------------------------------------------------
# Command Validation Engine

validate_and_run() {
    raw_input="$1"

    # Trim leading/trailing whitespace
    clean_input=$(echo "$raw_input" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$clean_input" ] && return 0

    # 1. Block dangerous control characters, redirection, background execution & subshell syntax
    CR=$(printf '\r')
    NL='
'
    case "$clean_input" in
        *"$NL"*|*"$CR"*)
            printf "%b[!] Security Error: Multi-line command execution is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
        *">"*|*"<"*)
            printf "%b[!] Security Error: File redirection (>, >>, <) is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
        *"\`"*|*"\$"*)
            printf "%b[!] Security Error: Subshell execution and variable expansion (\`, $) are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
        *";"*|*"&"*|*"||"*)
            printf "%b[!] Security Error: Command chaining (; && ||) and background execution (&) are prohibited. Use pipelines (|) with allowed tools.%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
    esac

    # 2. Check built-ins
    case "$clean_input" in
        env|printenv)
            printenv 2>/dev/null || env
            return 0
            ;;
        request\ *|req\ *|ask\ *)
            target_cmd=$(echo "$clean_input" | sed -e 's/^request[[:space:]]*//' -e 's/^req[[:space:]]*//' -e 's/^ask[[:space:]]*//')
            target_cmd=$(echo "$target_cmd" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [ -z "$target_cmd" ]; then
                printf "%bUsage: request <command> [arguments]%b\n" "$C_CYAN" "$C_RESET"
                return 1
            fi
            t_base=""
            saved_pifs="$IFS"
            IFS="|"
            for p_stage in $target_cmd; do
                IFS="$saved_pifs"
                p_stage=$(echo "$p_stage" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                [ -z "$p_stage" ] && continue
                c_tok=$(echo "$p_stage" | awk '{print $1}')
                b_tok=$(basename "$c_tok")
                case "$b_tok" in
                    uptime|date|free|df|ps|top|uname|dmesg|sysinfo|cpuinfo|meminfo|temperature|lsmod|\
                    netstat|route|arp|ping|ping6|traceroute|traceroute6|mtr|nslookup|dig|host|wl|ethtool|\
                    mii-tool|ethctl|robocfg|leases|dhcp-leases|wifi|ports|logs|help|exit|quit|clear|\
                    cat|head|tail|more|less|grep|egrep|fgrep|rg|tree|ls|dir|vdir|du|wc|sort|uniq|cut|column|\
                    tr|diff|strings|stat|file|hexdump|locate|which|whereis|echo|printf|who|w|id)
                        ;;
                    *)
                        if ! is_cmd_approved "$b_tok"; then
                            t_base="$b_tok"
                            break
                        fi
                        ;;
                esac
            done
            IFS="$saved_pifs"
            if [ -z "$t_base" ]; then
                t_base=$(echo "$target_cmd" | awk '{print $1}')
                t_base=$(basename "$t_base")
            fi
            request_command_approval "$target_cmd" "$t_base"
            return $?
            ;;
        request|req|ask)
            printf "%bUsage: request <command> [arguments]%b\n" "$C_CYAN" "$C_RESET"
            printf "  Submits a real-time permission request to the router host.\n"
            printf "  Host can approve for the entire session or for a single execution.\n\n"
            return 1
            ;;
        help|h|\?)
            show_help
            return 0
            ;;
        sysinfo)
            show_sysinfo
            return 0
            ;;
        leases|dhcp-leases)
            show_leases
            return 0
            ;;
        wifi)
            show_wifi
            return 0
            ;;
        ports)
            show_ports
            return 0
            ;;
        logs)
            logread 2>/dev/null | tail -n 50
            return 0
            ;;
        clear)
            printf "\033[2J\033[H"
            return 0
            ;;
        exit|quit|q)
            printf "\n%bSession disconnected.%b\n" "$C_CYAN" "$C_RESET"
            exit 0
            ;;
    esac

    # 3. Validate each pipeline stage
    sanitized_pipeline=""
    top_flag="-b -n 1"
    if [ "$(uname -s 2>/dev/null || echo "")" = "Darwin" ]; then
        top_flag="-l 1 -n 0"
    fi

    saved_ifs="$IFS"
    IFS="|"
    for stage in $clean_input; do
        IFS="$saved_ifs"
        stage=$(echo "$stage" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        if [ -z "$stage" ]; then
            printf "%b[!] Syntax Error: Empty pipeline stage.%b\n" "$C_RED" "$C_RESET"
            return 1
        fi

        # Canonicalize stage for security inspection:
        # Strip quotes and backslashes, normalize spaces and tabs
        stage_canon=$(printf "%s" "$stage" | sed -e 's/\\//g' -e 's/"//g' -e "s/'//g" | tr '\t' ' ' | sed -e 's/[[:space:]][[:space:]]*/ /g' -e 's/^ //' -e 's/ $//')
        if [ -z "$stage_canon" ]; then
            printf "%b[!] Syntax Error: Empty pipeline stage after canonicalization.%b\n" "$C_RED" "$C_RESET"
            return 1
        fi

        cmd_token=$(echo "$stage_canon" | awk '{print $1}')
        base_cmd=$(basename "$cmd_token")
        sub_arg=$(echo "$stage_canon" | awk '{print $2}')

        case "$base_cmd" in
            uptime|free|df|ps|uname|sysinfo|cpuinfo|meminfo|temperature|lsmod|\
            netstat|traceroute|traceroute6|mtr|nslookup|dig|host|\
            leases|dhcp-leases|wifi|ports|logs|help|exit|quit|clear|\
            cut|column|tr|locate|which|whereis|echo|printf|who|w|id)
                ;;
            top)
                # Batch execution only to prevent interactive process signal killing
                ;;
            dmesg)
                for d_tok in $stage_canon; do
                    case "$d_tok" in
                        dmesg) ;;
                        -*[cC]*)
                            printf "%b[!] Security Error: Clearing kernel ring buffer (dmesg -c/-C) is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                            return 1
                            ;;
                    esac
                done
                ;;
            ping|ping6)
                for p_tok in $stage_canon; do
                    case "$p_tok" in
                        ping|ping6) ;;
                        -*[fF]*)
                            printf "%b[!] Security Error: Flood pinging (ping -f) is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                            return 1
                            ;;
                    esac
                done
                ;;
            date)
                date_mut=0
                for d_tok in $stage_canon; do
                    case "$d_tok" in
                        date) ;;
                        -u|-R|-I*|+*) ;;
                        -*[sS]*|--set*) date_mut=1; break ;;
                        [0-9][0-9][0-9][0-9]*) date_mut=1; break ;;
                    esac
                done
                if [ "$date_mut" -eq 1 ]; then
                    printf "%b[!] Security Error: Modifying system date/time is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                    return 1
                fi
                ;;
            robocfg)
                robocfg_mut=0
                for r_tok in $stage_canon; do
                    case "$r_tok" in
                        robocfg) ;;
                        show) ;;
                        *) robocfg_mut=1; break ;;
                    esac
                done
                if [ "$robocfg_mut" -eq 1 ] && ! is_cmd_approved "robocfg"; then
                    printf "%b[!] Security Error: Hardware switch mutation with robocfg is prohibited in view-only mode. Only 'robocfg show' is permitted.%b\n" "$C_RED" "$C_RESET"
                    return 1
                fi
                ;;
            ethtool)
                for e_tok in $stage_canon; do
                    case "$e_tok" in
                        ethtool) ;;
                        -*[sKkACGpPrReEd]*|--change|--features|--pause|--coalesce|--ring|--identify|--reset)
                            if ! is_cmd_approved "ethtool"; then
                                printf "%b[!] Security Error: Hardware interface mutation with ethtool is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                                return 1
                            fi
                            ;;
                    esac
                done
                ;;
            mii-tool)
                for m_tok in $stage_canon; do
                    case "$m_tok" in
                        mii-tool) ;;
                        -*[FfrR]*|--force|--restart)
                            if ! is_cmd_approved "mii-tool"; then
                                printf "%b[!] Security Error: Media interface mutation with mii-tool is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                                return 1
                            fi
                            ;;
                    esac
                done
                ;;
            ethctl)
                case "$stage_canon" in
                    *"media-type"*|*"speed"*|*"duplex"*|*"vlan"*|*"enable"*|*"disable"*)
                        if ! is_cmd_approved "ethctl"; then
                            printf "%b[!] Security Error: Interface state mutation with ethctl is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                            return 1
                        fi
                        ;;
                esac
                ;;
            cat|head|tail|more|less|grep|egrep|fgrep|rg|tree|ls|dir|vdir|du|wc|diff|strings|hexdump|stat|file)
                if is_sensitive_file_access "$stage_canon"; then
                    printf "%b[!] Security Error: Access to sensitive system security files is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                    return 1
                fi

                if [ "$base_cmd" = "tree" ]; then
                    for t_tok in $stage_canon; do
                        case "$t_tok" in
                            tree) ;;
                            -*[oO]*|--output*)
                                printf "%b[!] Security Error: 'tree' output file redirection (-o) is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                                return 1
                                ;;
                        esac
                    done
                elif [ "$base_cmd" = "diff" ]; then
                    for d_tok in $stage_canon; do
                        case "$d_tok" in
                            diff) ;;
                            --diff*|-*[D]*)
                                printf "%b[!] Security Error: 'diff' external program execution is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                                return 1
                            ;;
                        esac
                    done
                fi
                ;;
            sort)
                sort_has_out=0
                for s_tok in $stage_canon; do
                    case "$s_tok" in
                        sort) ;;
                        -*[oO]*|--output*|--compress*)
                            sort_has_out=1
                            break
                            ;;
                    esac
                done
                if [ "$sort_has_out" -eq 1 ]; then
                    printf "%b[!] Security Error: 'sort' file writing (-o) and external compressor options are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                    return 1
                fi
                if is_sensitive_file_access "$stage_canon"; then
                    printf "%b[!] Security Error: Access to sensitive system security files is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                    return 1
                fi
                ;;
            uniq)
                u_non_flags=0
                for u_tok in $stage_canon; do
                    case "$u_tok" in
                        uniq) ;;
                        -*) ;;
                        *) u_non_flags=$((u_non_flags + 1)) ;;
                    esac
                done
                if [ "$u_non_flags" -ge 2 ]; then
                    printf "%b[!] Security Error: 'uniq' output file redirection is prohibited in view-only mode. Use pipelines instead.%b\n" "$C_RED" "$C_RESET"
                    return 1
                fi
                if is_sensitive_file_access "$stage_canon"; then
                    printf "%b[!] Security Error: Access to sensitive system security files is prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                    return 1
                fi
                ;;
            route)
                route_mut=0
                for r_tok in $stage_canon; do
                    case "$r_tok" in
                        route) ;;
                        add|del|delete) route_mut=1; break ;;
                    esac
                done
                if [ "$route_mut" -eq 1 ]; then
                    if ! is_cmd_approved "route"; then
                        if is_cmd_denied "route"; then
                            printf "%b[!] Security Error: 'route' modification operations have been denied by host for this session.%b\n" "$C_RED" "$C_RESET"
                            return 1
                        fi
                        printf "%b[!] Security Error: 'route' modification operations (add/del) are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                        if [ -t 0 ]; then
                            printf "    Would you like to request host approval for '%s'? [y/N]: " "$clean_input"
                            if read -r ask_resp; then
                                case "$ask_resp" in
                                    [yY]*)
                                        request_command_approval "$clean_input" "route"
                                        return $?
                                        ;;
                                esac
                            fi
                        else
                            printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                        fi
                        return 1
                    fi
                fi
                ;;
            arp)
                arp_mut=0
                for a_tok in $stage_canon; do
                    case "$a_tok" in
                        arp) ;;
                        -*[sdDfF]*|--delete) arp_mut=1; break ;;
                    esac
                done
                if [ "$arp_mut" -eq 1 ]; then
                    if ! is_cmd_approved "arp"; then
                        if is_cmd_denied "arp"; then
                            printf "%b[!] Security Error: 'arp' modification operations have been denied by host for this session.%b\n" "$C_RED" "$C_RESET"
                            return 1
                        fi
                        printf "%b[!] Security Error: 'arp' modification operations (-s/-d/-f) are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                        if [ -t 0 ]; then
                            printf "    Would you like to request host approval for '%s'? [y/N]: " "$clean_input"
                            if read -r ask_resp; then
                                case "$ask_resp" in
                                    [yY]*)
                                        request_command_approval "$clean_input" "arp"
                                        return $?
                                        ;;
                                esac
                            fi
                        else
                            printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                        fi
                        return 1
                    fi
                fi
                ;;
            wl)
                wl_mut=0
                for w_tok in $stage_canon; do
                    case "$w_tok" in
                        wl) ;;
                        down|up|join|disassoc|deauth|restart|set|mute|out) wl_mut=1; break ;;
                    esac
                done
                if [ "$wl_mut" -eq 1 ]; then
                    if ! is_cmd_approved "wl"; then
                        if is_cmd_denied "wl"; then
                            printf "%b[!] Security Error: 'wl' state-changing operations have been denied by host for this session.%b\n" "$C_RED" "$C_RESET"
                            return 1
                        fi
                        printf "%b[!] Security Error: 'wl' state-changing operations are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                        if [ -t 0 ]; then
                            printf "    Would you like to request host approval for '%s'? [y/N]: " "$clean_input"
                            if read -r ask_resp; then
                                case "$ask_resp" in
                                    [yY]*)
                                        request_command_approval "$clean_input" "wl"
                                        return $?
                                        ;;
                                esac
                            fi
                        else
                            printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                        fi
                        return 1
                    fi
                fi
                ;;
            env)
                printf "%b[!] Security Error: Executing commands via 'env' is prohibited in view-only mode. Type 'env' alone to view environment variables.%b\n" "$C_RED" "$C_RESET"
                return 1
                ;;
            nvram)
                nv_action=""
                nv_key=""
                for n_tok in $stage_canon; do
                    case "$n_tok" in
                        nvram) ;;
                        -*) ;;
                        *)
                            if [ -z "$nv_action" ]; then
                                nv_action="$n_tok"
                            elif [ -z "$nv_key" ]; then
                                nv_key="$n_tok"
                            fi
                            ;;
                    esac
                done

                case "$nv_action" in
                    get)
                        is_nv_after_get=0
                        for nv_tok in $stage_canon; do
                            if [ "$nv_tok" = "get" ]; then
                                is_nv_after_get=1
                                continue
                            fi
                            if [ "$is_nv_after_get" -eq 1 ]; then
                                case "$nv_tok" in
                                    -*) ;;
                                    *[pP][aA][sS][sS]*|*[cC][eE][rR][tT]*|*[cC][rR][tT]*|\
                                    *[pP][rR][iI][vV]*|*[sS][eE][cC][rR][eE][tT]*|*[kK][eE][yY]*|\
                                    *[pP][sS][kK]*|*[pP][iI][nN]*|*[tT][oO][kK][eE][nN]*|*[aA][uU][tT][hH]*|\
                                    *[uU][sS][eE][rR]*|*[aA][cC][cC]_*|*[hH][aA][sS][hH]*|\
                                    *[sS][aA][lL][tT]*|*[cC][rR][eE][dD]*|*[sS][eE][eE][dD]*|\
                                    *[oO][vV][pP][nN]*|*[wW][gG]*)
                                        printf "%b[!] Security Error: Access to sensitive nvram credential variable '%s' is prohibited in view-only mode.%b\n" "$C_RED" "$nv_tok" "$C_RESET"
                                        return 1
                                        ;;
                                esac
                            fi
                        done
                        ;;
                    show)
                        if ! is_cmd_approved "nvram"; then
                            if is_cmd_denied "nvram"; then
                                printf "%b[!] Security Error: 'nvram show' has been denied by host for this session.%b\n" "$C_RED" "$C_RESET"
                                return 1
                            fi
                            printf "%b[!] Security Error: 'nvram show' dumps all plaintext credentials. Use 'nvram get <key>' for specific configuration keys.%b\n" "$C_RED" "$C_RESET"
                            if [ -t 0 ]; then
                                printf "    Would you like to request host approval for 'nvram show'? [y/N]: "
                                if read -r ask_resp; then
                                    case "$ask_resp" in
                                        [yY]*)
                                            request_command_approval "$clean_input" "nvram"
                                            return $?
                                            ;;
                                    esac
                                fi
                            else
                                printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                            fi
                            return 1
                        fi
                        ;;
                    *)
                        if ! is_cmd_approved "nvram"; then
                            if is_cmd_denied "nvram"; then
                                printf "%b[!] Security Error: 'nvram %s' has been denied by host for this session.%b\n" "$C_RED" "${nv_action:-<empty>}" "$C_RESET"
                                return 1
                            fi
                            printf "%b[!] Security Error: 'nvram %s' is blocked. Only 'nvram get' is permitted in view-only mode.%b\n" "$C_RED" "${nv_action:-<empty>}" "$C_RESET"
                            if [ -t 0 ]; then
                                printf "    Would you like to request host approval for '%s'? [y/N]: " "$clean_input"
                                if read -r ask_resp; then
                                    case "$ask_resp" in
                                        [yY]*)
                                            request_command_approval "$clean_input" "nvram"
                                            return $?
                                            ;;
                                    esac
                                fi
                            else
                                printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                            fi
                            return 1
                        fi
                        ;;
                esac
                ;;
            opkg)
                case "$sub_arg" in
                    list|list-installed|info|find|status|search|depends|whatdepends)
                        ;;
                    *)
                        if ! is_cmd_approved "opkg"; then
                            if is_cmd_denied "opkg"; then
                                printf "%b[!] Security Error: 'opkg %s' has been denied by host for this session.%b\n" "$C_RED" "${sub_arg:-<empty>}" "$C_RESET"
                                return 1
                            fi
                            printf "%b[!] Security Error: 'opkg %s' is blocked. Only read-only package queries are permitted.%b\n" "$C_RED" "${sub_arg:-<empty>}" "$C_RESET"
                            if [ -t 0 ]; then
                                printf "    Would you like to request host approval for '%s'? [y/N]: " "$clean_input"
                                if read -r ask_resp; then
                                    case "$ask_resp" in
                                        [yY]*)
                                            request_command_approval "$clean_input" "opkg"
                                            return $?
                                            ;;
                                    esac
                                fi
                            else
                                printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                            fi
                            return 1
                        fi
                        ;;
                esac
                ;;
            ip)
                case "$sub_arg" in
                    addr|route|neigh|link|rule|a|r|l)
                        ip_mut=0
                        for i_tok in $stage_canon; do
                            case "$i_tok" in
                                add|del|delete|change|replace|set) ip_mut=1; break ;;
                            esac
                        done
                        if [ "$ip_mut" -eq 1 ]; then
                            if ! is_cmd_approved "ip"; then
                                if is_cmd_denied "ip"; then
                                    printf "%b[!] Security Error: 'ip' write operations have been denied by host for this session.%b\n" "$C_RED" "$C_RESET"
                                    return 1
                                fi
                                printf "%b[!] Security Error: 'ip' write/modify operations are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                                if [ -t 0 ]; then
                                    printf "    Would you like to request host approval for '%s'? [y/N]: " "$clean_input"
                                    if read -r ask_resp; then
                                        case "$ask_resp" in
                                            [yY]*)
                                                request_command_approval "$clean_input" "ip"
                                                return $?
                                                ;;
                                        esac
                                    fi
                                else
                                    printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                                fi
                                return 1
                            fi
                        fi
                        ;;
                    *)
                        if ! is_cmd_approved "ip"; then
                            if is_cmd_denied "ip"; then
                                printf "%b[!] Security Error: 'ip %s' has been denied by host for this session.%b\n" "$C_RED" "${sub_arg:-<empty>}" "$C_RESET"
                                return 1
                            fi
                            printf "%b[!] Security Error: 'ip %s' is blocked. Only inspection verbs are permitted.%b\n" "$C_RED" "${sub_arg:-<empty>}" "$C_RESET"
                            if [ -t 0 ]; then
                                printf "    Would you like to request host approval for '%s'? [y/N]: " "$clean_input"
                                if read -r ask_resp; then
                                    case "$ask_resp" in
                                        [yY]*)
                                            request_command_approval "$clean_input" "ip"
                                            return $?
                                            ;;
                                    esac
                                fi
                            else
                                printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                            fi
                            return 1
                        fi
                        ;;
                esac
                ;;
            ifconfig)
                if_mut=0
                for if_tok in $stage_canon; do
                    case "$if_tok" in
                        ifconfig) ;;
                        up|down|netmask|broadcast|pointopoint|mtu|hw|metric) if_mut=1; break ;;
                        [0-9]*.[0-9]*.[0-9]*.[0-9]*) if_mut=1; break ;;
                    esac
                done
                if [ "$if_mut" -eq 1 ]; then
                    if ! is_cmd_approved "ifconfig"; then
                        if is_cmd_denied "ifconfig"; then
                            printf "%b[!] Security Error: 'ifconfig' modification operations have been denied by host for this session.%b\n" "$C_RED" "$C_RESET"
                            return 1
                        fi
                        printf "%b[!] Security Error: 'ifconfig' modification operations are prohibited in view-only mode.%b\n" "$C_RED" "$C_RESET"
                        if [ -t 0 ]; then
                            printf "    Would you like to request host approval for '%s'? [y/N]: " "$clean_input"
                            if read -r ask_resp; then
                                case "$ask_resp" in
                                    [yY]*)
                                        request_command_approval "$clean_input" "ifconfig"
                                        return $?
                                        ;;
                                esac
                            fi
                        else
                            printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                        fi
                        return 1
                    fi
                fi
                ;;
            logread)
                ;;
            *)
                if ! is_cmd_approved "$base_cmd"; then
                    if is_cmd_denied "$base_cmd"; then
                        printf "%b[!] Security Error: Command '%s' has been denied by host for this session.%b\n" "$C_RED" "$base_cmd" "$C_RESET"
                        return 1
                    fi
                    printf "%b[!] Security Error: Command '%s' is not permitted in view-only mode.%b\n" "$C_RED" "$base_cmd" "$C_RESET"
                    if [ -t 0 ]; then
                        printf "    Would you like to request host approval for '%s'? [y/N]: " "$base_cmd"
                        if read -r ask_resp; then
                            case "$ask_resp" in
                                [yY]*)
                                    request_command_approval "$clean_input" "$base_cmd"
                                    return $?
                                    ;;
                            esac
                        fi
                    else
                        printf "    Type 'request %s' to ask host for approval.\n" "$clean_input"
                    fi
                    return 1
                fi
                ;;
        esac

        sanitized_stage="$stage"
        if [ "$base_cmd" = "less" ] || [ "$base_cmd" = "more" ]; then
            sanitized_stage=$(printf "%s" "$stage" | sed -e 's|^[[:space:]]*[^[:space:]]*|safe_stream|')
        elif [ "$base_cmd" = "top" ]; then
            case "$stage_canon" in
                *-b*|*-n*|*-l*) ;;
                *)
                    sanitized_stage=$(printf "%s" "$stage" | sed -e "s|^[[:space:]]*${cmd_token}|${cmd_token} ${top_flag}|")
                    ;;
            esac
        fi

        if [ -z "$sanitized_pipeline" ]; then
            sanitized_pipeline="$sanitized_stage"
        else
            sanitized_pipeline="${sanitized_pipeline} | ${sanitized_stage}"
        fi
    done
    IFS="$saved_ifs"

    # 4. Execute validated pipeline with safe environment
    exec_input="${sanitized_pipeline:-$clean_input}"
    eval "$exec_input"
    return $?
}

# -------------------------------------------------------------------------------------------------------------------------
# Execution Mode Dispatcher

# Non-interactive command invocation (-c "<command>")
if [ "${1:-}" = "-c" ]; then
    shift
    cmd_to_run="$*"
    validate_and_run "$cmd_to_run"
    exit $?
fi

# Interactive Login Session
print_banner

while true; do
    printf "%btailcatzero-view:~$ %b" "$C_GREEN" "$C_RESET"
    if ! read -r user_cmd; then
        printf "\n%bSession closed.%b\n" "$C_CYAN" "$C_RESET"
        exit 0
    fi
    validate_and_run "$user_cmd" || true
done
