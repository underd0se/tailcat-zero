#!/bin/sh
# =========================================================================================================================
# TailCat-Merlin — Ephemeral WireGuard Tunnel & Multi-Service Manager for Asuswrt-Merlin
# Managed by AMTM standard conventions.
# =========================================================================================================================
# shellcheck disable=SC2153

set -eu

VERSION="1.3.0"
CONFIG_DIR="/jffs/addons/tailcat"
CONFIG_FILE="${CONFIG_DIR}/tailcat.cfg"
BIN_DIR="${CONFIG_DIR}/bin"
TAILCAT_BIN="${BIN_DIR}/tailcat"
SESSIONS_DIR="/tmp/tailcat_sessions"
LOG_TAG="tailcat-merlin"

# ANSI Color Palette
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_KEY="\033[1;4m" # Bold + Underline for hotkeys
C_GREEN="\033[1;32m"
C_CYAN="\033[1;36m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;37m" # Readable muted white/gray
C_WHITE="\033[1;37m" # Crisp high-contrast white
C_MAGENTA="\033[1;35m"

# Default Configuration
DEFAULT_TIMEOUT=30 # 30 minutes
DERP_URL="https://tailcat.dev/derpmap.json"
export DERP_URL

# Load Config if exists
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

TIMEOUT_MINUTES="${TIMEOUT_MINUTES:-$DEFAULT_TIMEOUT}"
mkdir -p "$SESSIONS_DIR"

# -------------------------------------------------------------------------------------------------------------------------
# Helper Functions

log_msg() {
    logger -t "$LOG_TAG" "$*"
}

is_service_active() {
    s_id="$1"
    s_file="${SESSIONS_DIR}/${s_id}.env"
    if [ -f "$s_file" ]; then
        # shellcheck disable=SC1090
        . "$s_file"
        if [ -n "${PID:-}" ] && kill -0 "$PID" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

has_any_active_session() {
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            return 0
        fi
    done
    return 1
}

get_active_service_count() {
    cnt=0
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            cnt=$((cnt + 1))
        fi
    done
    echo "$cnt"
}

get_free_space() {
    target_path="$1"
    if [ -d "$target_path" ]; then
        df -h "$target_path" 2>/dev/null | awk 'NR==2 {print $4}' || echo "N/A"
    else
        echo "N/A"
    fi
}

get_service_time_left() {
    s_id="$1"
    s_file="${SESSIONS_DIR}/${s_id}.env"
    if is_service_active "$s_id"; then
        # shellcheck disable=SC1090
        . "$s_file"
        now=$(date +%s)
        if [ "$now" -lt "${EXPIRE_EPOCH:-0}" ]; then
            diff=$(( EXPIRE_EPOCH - now ))
            if [ "$diff" -lt 60 ]; then
                printf "< 1m remaining"
                return
            fi
            remaining=$(( diff / 60 ))
            printf "%sm remaining" "$remaining"
            return
        fi
    fi
    printf "Expired"
}

get_service_badge() {
    s_id="$1"
    if is_service_active "$s_id"; then
        tl=$(get_service_time_left "$s_id")
        printf "%b[🟢 Active: %s]%b" "$C_GREEN" "$tl" "$C_RESET"
    else
        printf "%b[⚪ Inactive]%b" "$C_GRAY" "$C_RESET"
    fi
}

stop_single_session() {
    s_id="$1"
    s_file="${SESSIONS_DIR}/${s_id}.env"
    addr_file="/tmp/tailcat_addr_${s_id}.txt"
    if [ -f "$s_file" ]; then
        # shellcheck disable=SC1090
        . "$s_file"
        if [ -n "${PID:-}" ]; then
            kill -9 "$PID" 2>/dev/null || true
        fi
        if [ -n "${WATCHDOG_PID:-}" ]; then
            kill -9 "$WATCHDOG_PID" 2>/dev/null || true
        fi
        rm -f "$s_file" "$addr_file"
        log_msg "TailCat session stopped: ${s_id}"
        printf "\n%b[+] Stopped session: %s%b\n" "$C_GREEN" "${DESC:-$s_id}" "$C_RESET"
    else
        rm -f "$s_file" "$addr_file"
    fi
}

stop_all_sessions() {
    found=0
    for s in SSH RECV FILES WEBGUI; do
        if [ -f "${SESSIONS_DIR}/${s}.env" ]; then
            stop_single_session "$s"
            found=1
        fi
    done
    if [ "$found" = "0" ]; then
        printf "\n%b[!] No active TailCat sessions found.%b\n" "$C_YELLOW" "$C_RESET"
    fi
}

stop_sessions_menu() {
    count=$(get_active_service_count)
    if [ "$count" -eq 0 ]; then
        printf "\n%b[!] No active TailCat sessions found.%b\n" "$C_YELLOW" "$C_RESET"
        return
    fi
    if [ "$count" -eq 1 ]; then
        stop_all_sessions
        return
    fi

    printf "\n%bStop Running Sessions:%b\n\n" "$C_CYAN" "$C_RESET"
    idx=1
    svc_list=""
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            s_file="${SESSIONS_DIR}/${s}.env"
            # shellcheck disable=SC1090
            . "$s_file"
            tl=$(get_service_time_left "$s")
            printf "  %d. Stop %s (%s)\n" "$idx" "${DESC}" "$tl"
            svc_list="${svc_list} ${s}"
            idx=$((idx + 1))
        fi
    done
    printf "  %d. 🛑 Stop ALL Sessions\n\n" "$idx"
    printf " Choice [1-%d, default %d, e to cancel]: " "$idx" "$idx"
    if ! read -r s_choice; then
        return
    fi
    case "$s_choice" in
        [eE]|[bB]|cancel|exit)
            printf "\n%b[*] Operation cancelled.%b\n" "$C_YELLOW" "$C_RESET"
            return
            ;;
        "$idx"|'')
            stop_all_sessions
            return
            ;;
        *[!0-9]*)
            printf "\n%b[!] Invalid selection.%b\n" "$C_RED" "$C_RESET"
            return
            ;;
    esac

    c_idx=1
    for s in $svc_list; do
        if [ "$c_idx" -eq "$s_choice" ]; then
            stop_single_session "$s"
            return
        fi
        c_idx=$((c_idx + 1))
    done
    printf "\n%b[!] Invalid selection.%b\n" "$C_RED" "$C_RESET"
}

draw_cat() {
    printf "                            %b╱|、%b\n" "$C_CYAN" "$C_RESET"
    printf "                          %b(˚ˎ 。7%b\n" "$C_CYAN" "$C_RESET"
    printf "                           %b|、˜〵%b\n" "$C_CYAN" "$C_RESET"
    printf "                          %bじしˍ,)ノ%b\n\n" "$C_CYAN" "$C_RESET"
}

start_tunnel() {
    service_type="$1"
    subcmd="$2"
    desc="$3"
    extra_info="${4:-}"

    if is_service_active "$service_type"; then
        printf "\n%b[*] %s is already running.%b\n\n" "$C_YELLOW" "$desc" "$C_RESET"
        printf "  1. View connect card & QR code\n"
        printf "  2. Stop this session\n"
        printf "  3. Restart session\n\n"
        printf " Choice [1-3, default 1, e to cancel]: "
        if ! read -r act_choice; then
            return
        fi
        case "$act_choice" in
            1|'')
                interactive_session_card "$service_type"
                return
                ;;
            2)
                stop_single_session "$service_type"
                return
                ;;
            3)
                stop_single_session "$service_type"
                ;;
            *)
                printf "\n%b[*] Operation cancelled.%b\n" "$C_YELLOW" "$C_RESET"
                return
                ;;
        esac
    fi

    if [ ! -x "$TAILCAT_BIN" ]; then
        printf "\n%b[!] TailCat binary not found at %s.%b\n" "$C_RED" "$TAILCAT_BIN" "$C_RESET"
        printf "%b[*] Please run Option 8 to download/reinstall the binary.%b\n" "$C_YELLOW" "$C_RESET"
        return 1
    fi

    mkdir -p "$SESSIONS_DIR"
    addr_file="/tmp/tailcat_addr_${service_type}.txt"
    rm -f "$addr_file"

    printf "\n%b[*] Starting %s...%b\n" "$C_CYAN" "$desc" "$C_RESET"

    # Start tailcat in background with address output file
    # shellcheck disable=SC2086
    TAILCAT_ADDR_FILE="$addr_file" "$TAILCAT_BIN" $subcmd >/dev/null 2>&1 &
    tailcat_pid=$!

    # Wait up to 10 seconds for address file
    count=0
    while [ $count -lt 10 ]; do
        if [ -s "$addr_file" ]; then
            break
        fi
        sleep 1
        count=$((count + 1))
    done

    if [ ! -s "$addr_file" ] || ! kill -0 "$tailcat_pid" 2>/dev/null; then
        printf "\n%b[-] Failed to start %s.%b\n" "$C_RED" "$desc" "$C_RESET"
        kill -9 "$tailcat_pid" 2>/dev/null || true
        rm -f "$addr_file"
        return 1
    fi

    token=$(tr -d '\r\n' < "$addr_file")
    now=$(date +%s)
    timeout_sec=$(( TIMEOUT_MINUTES * 60 ))
    expire_epoch=$(( now + timeout_sec ))
    session_file="${SESSIONS_DIR}/${service_type}.env"

    # Launch Auto-Kill Watcher Subshell for this specific service
    (
        sleep "$timeout_sec"
        if kill -0 "$tailcat_pid" 2>/dev/null; then
            kill -9 "$tailcat_pid" 2>/dev/null || true
            rm -f "$session_file" "$addr_file"
            logger -t "$LOG_TAG" "Session ${service_type} auto-expired after ${TIMEOUT_MINUTES}m"
        fi
    ) &
    watchdog_pid=$!

    # Save Session State
    cat <<EOF > "$session_file"
PID=${tailcat_pid}
WATCHDOG_PID=${watchdog_pid}
SERVICE_ID="${service_type}"
DESC="${desc}"
TOKEN="${token}"
EXTRA_INFO="${extra_info}"
START_EPOCH=${now}
EXPIRE_EPOCH=${expire_epoch}
TIMEOUT_MINUTES=${TIMEOUT_MINUTES}
EOF

    log_msg "TailCat session started: ${service_type} (Auto-kill: ${TIMEOUT_MINUTES}m)"
    interactive_session_card "$service_type"
}

get_client_connect_cmd() {
    s_type="$1"
    s_token="$2"

    case "$s_type" in
        "SSH")
            printf "tailcat ssh %s" "$s_token"
            ;;
        "RECV")
            printf "tailcat cp <file_or_dir> %s:" "$s_token"
            ;;
        "FILES")
            printf "tailcat ls -l %s" "$s_token"
            ;;
        "WEBGUI")
            printf "tailcat socks %s" "$s_token"
            ;;
        *)
            printf "tailcat %s" "$s_token"
            ;;
    esac
}

render_multi_session_overview() {
    draw_cat
    cnt=$(get_active_service_count)
    printf "%b%b========================================================================%b\n" "$C_GREEN" "$C_BOLD" "$C_RESET"
    printf "  %b%b🐱 TailCat-Merlin — Active Sessions (%d Running)%b\n" "$C_CYAN" "$C_BOLD" "$cnt" "$C_RESET"
    printf "%b========================================================================%b\n\n" "$C_GREEN" "$C_RESET"

    idx=1
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            s_file="${SESSIONS_DIR}/${s}.env"
            # shellcheck disable=SC1090
            . "$s_file"
            tl=$(get_service_time_left "$s")
            printf "  %b[%d]%b %b%-28s%b ⏱️  %-14s 🔒 P2P\n" "$C_BOLD" "$idx" "$C_RESET" "$C_MAGENTA" "${DESC}" "$C_RESET" "$tl"
            idx=$((idx + 1))
        fi
    done

    printf "\n  %b💬 Copy & Paste Connect Commands:%b\n" "$C_BOLD" "$C_RESET"
    printf "  %b────────────────────────────────────────────────────────────────────────%b\n" "$C_CYAN" "$C_RESET"
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            s_file="${SESSIONS_DIR}/${s}.env"
            # shellcheck disable=SC1090
            . "$s_file"
            cmd=$(get_client_connect_cmd "$s" "$TOKEN")
            if [ "$s" = "WEBGUI" ]; then
                printf "  • %bWebGUI:%b  %btailcat socks %s%b (Open https://localhost:8443)\n" "$C_BOLD" "$C_RESET" "$C_YELLOW" "$TOKEN" "$C_RESET"
            else
                printf "  • %b%-7s%b %b%s%b\n" "$C_BOLD" "${s}:" "$C_RESET" "$C_YELLOW" "$cmd" "$C_RESET"
            fi
        fi
    done
    printf "  %b────────────────────────────────────────────────────────────────────────%b\n\n" "$C_CYAN" "$C_RESET"
    printf "%b========================================================================%b\n\n" "$C_GREEN" "$C_RESET"
}

render_single_session_card() {
    s_id="$1"
    show_qr="${2:-0}"
    s_file="${SESSIONS_DIR}/${s_id}.env"

    if ! is_service_active "$s_id"; then
        printf "\n%b[!] Session %s is not active.%b\n" "$C_YELLOW" "$s_id" "$C_RESET"
        return 1
    fi

    # shellcheck disable=SC1090
    . "$s_file"
    time_left=$(get_service_time_left "$s_id")
    cmd=$(get_client_connect_cmd "$s_id" "$TOKEN")

    draw_cat

    printf "%b%b========================================================================%b\n" "$C_GREEN" "$C_BOLD" "$C_RESET"
    printf "  %b%b🐱 TailCat-Merlin — Active Session%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
    printf "%b========================================================================%b\n\n" "$C_GREEN" "$C_RESET"

    printf "  %bService:%b     %b%s%b\n" "$C_BOLD" "$C_RESET" "$C_MAGENTA" "${DESC}" "$C_RESET"
    if [ -n "${EXTRA_INFO:-}" ]; then
        printf "  %bDestination:%b %s\n" "$C_BOLD" "$C_RESET" "${EXTRA_INFO}"
    fi
    printf "  %bAuto-Kill:%b   %b⏱️  %s%b\n" "$C_BOLD" "$C_RESET" "$C_YELLOW" "${time_left}" "$C_RESET"
    printf "  %bSecurity:%b    %b🔒 WireGuard P2P Encrypted (Zero WAN Ports Open)%b\n\n" "$C_BOLD" "$C_RESET" "$C_GREEN" "$C_RESET"

    printf "  %b💬 Copy & Paste to Friend / Admin Support:%b\n" "$C_BOLD" "$C_RESET"
    printf "  %b────────────────────────────────────────────────────────────────────────%b\n" "$C_CYAN" "$C_RESET"
    printf "  %bHey, I've opened a temporary TailCat session on my router (%s).%b\n" "$C_WHITE" "${time_left}" "$C_RESET"
    if [ "$s_id" = "WEBGUI" ]; then
        web_port="8443"
        case "${EXTRA_INFO:-}" in
            *HTTPS:\ 8443*|*8443*) web_port="8443" ;;
            *HTTPS:\ *|*HTTP:\ *) web_port=$(echo "${EXTRA_INFO}" | grep -oE '[0-9]+' | head -n1 || echo "8443") ;;
        esac
        printf "  %b1. Run: %btailcat socks %s%b\n" "$C_WHITE" "$C_YELLOW" "$TOKEN" "$C_RESET"
        printf "  %b2. Open browser: %bhttps://localhost:%s%b\n" "$C_WHITE" "$C_CYAN" "${web_port}" "$C_RESET"
    else
        printf "  %bRun: %b%s%b\n" "$C_WHITE" "$C_YELLOW" "$cmd" "$C_RESET"
    fi
    printf "  %b────────────────────────────────────────────────────────────────────────%b\n\n" "$C_CYAN" "$C_RESET"

    if [ "$show_qr" = "1" ] && [ -x "/usr/sbin/qrencode" ]; then
        printf "  %b📱 Scan QR Code on Mobile / Laptop:%b\n\n" "$C_BOLD" "$C_RESET"
        /usr/sbin/qrencode -t UTF8 -m 1 "$cmd" 2>/dev/null || /usr/sbin/qrencode -t ASCII -m 1 "$cmd" 2>/dev/null || true
        printf "\n"
    fi

    printf "%b========================================================================%b\n\n" "$C_GREEN" "$C_RESET"
    return 0
}

interactive_session_card() {
    cur_svc="${1:-ALL}"
    show_qr=0
    clear_scr=0

    while has_any_active_session; do
        if [ "$clear_scr" = "1" ]; then
            clear 2>/dev/null || printf "\033[2J\033[H"
        fi
        clear_scr=1

        active_cnt=$(get_active_service_count)
        if [ "$cur_svc" != "ALL" ] && ! is_service_active "$cur_svc"; then
            cur_svc="ALL"
        fi

        if [ "$cur_svc" = "ALL" ] && [ "$active_cnt" -eq 1 ]; then
            for s in SSH RECV FILES WEBGUI; do
                if is_service_active "$s"; then
                    cur_svc="$s"
                    break
                fi
            done
        fi

        if [ "$cur_svc" = "ALL" ]; then
            render_multi_session_overview
            printf "  Actions: 1-%d View/QR  |  🛑 %bS%btop All  |  🔄 %bR%befresh  |  ↩️ %bM%bain Menu: " "$active_cnt" "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET"
            if ! read -r act; then
                break
            fi
            case "$act" in
                [sS])
                    stop_all_sessions
                    break
                    ;;
                [rR])
                    ;;
                [mM]|[bB]|''|[eE])
                    break
                    ;;
                [1-4])
                    c_idx=1
                    for s in SSH RECV FILES WEBGUI; do
                        if is_service_active "$s"; then
                            if [ "$c_idx" -eq "$act" ]; then
                                cur_svc="$s"
                                show_qr=0
                                break
                            fi
                            c_idx=$((c_idx + 1))
                        fi
                    done
                    ;;
                *)
                    break
                    ;;
            esac
        else
            render_single_session_card "$cur_svc" "$show_qr"
            if [ "$show_qr" = "1" ]; then
                qr_label="📱 Hide ${C_KEY}Q${C_RESET}R"
            else
                qr_label="📱 Show ${C_KEY}Q${C_RESET}R"
            fi
            if [ "$active_cnt" -gt 1 ]; then
                printf "  Actions: 🛑 %bS%btop This  |  📋 %bA%bll Sessions  |  🔄 %bR%befresh  |  %b  |  ↩️ %bM%bain Menu: " "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$qr_label" "$C_KEY" "$C_RESET"
            else
                printf "  Actions: 🛑 %bS%btop Session  |  🔄 %bR%befresh  |  %b  |  ↩️ %bM%bain Menu: " "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$qr_label" "$C_KEY" "$C_RESET"
            fi

            if ! read -r act; then
                break
            fi
            case "$act" in
                [sS])
                    stop_single_session "$cur_svc"
                    if ! has_any_active_session; then
                        break
                    fi
                    cur_svc="ALL"
                    ;;
                [aA])
                    cur_svc="ALL"
                    show_qr=0
                    ;;
                [rR])
                    ;;
                [qQ])
                    if [ "$show_qr" = "1" ]; then
                        show_qr=0
                    else
                        show_qr=1
                    fi
                    ;;
                [mM]|[bB]|''|[eE])
                    break
                    ;;
                *)
                    break
                    ;;
            esac
        fi
    done
}

set_timeout_config() {
    printf "\n%bConfigure Session Auto-Kill Timeout%b\n\n" "$C_CYAN" "$C_RESET"
    printf "Current Timeout: %b%s minutes%b\n\n" "$C_BOLD" "${TIMEOUT_MINUTES}" "$C_RESET"
    printf "Enter new timeout in minutes [5-240] (default 30, e to cancel): "
    if ! read -r user_t; then
        return
    fi
    case "$user_t" in
        [eE]|[bB]|cancel|exit)
            printf "\n%b[*] Operation cancelled.%b\n" "$C_YELLOW" "$C_RESET"
            return
            ;;
        '')
            user_t=30
            ;;
        *[!0-9]*)
            printf "\n%b[!] Invalid number. Setting unchanged.%b\n" "$C_RED" "$C_RESET"
            return
            ;;
    esac

    if [ "$user_t" -lt 5 ] || [ "$user_t" -gt 240 ]; then
        printf "\n%b[!] Timeout must be between 5 and 240 minutes.%b\n" "$C_RED" "$C_RESET"
        return
    fi

    TIMEOUT_MINUTES="$user_t"
    mkdir -p "$CONFIG_DIR"
    echo "TIMEOUT_MINUTES=${TIMEOUT_MINUTES}" > "$CONFIG_FILE"
    printf "\n%b[+] Timeout updated to %s minutes.%b\n" "$C_GREEN" "${TIMEOUT_MINUTES}" "$C_RESET"
}

update_binary() {
    printf "\n%b[*] Checking router architecture & downloading official TailCat binary...%b\n" "$C_CYAN" "$C_RESET"
    arch=$(uname -m)
    pkg_arch=""
    case "$arch" in
        armv7*|armv6*|arm) pkg_arch="armv7" ;;
        aarch64*|arm64*)  pkg_arch="arm64" ;;
        *)
            printf "\n%b[!] Unsupported router architecture: %s%b\n" "$C_RED" "${arch}" "$C_RESET"
            return 1
            ;;
    esac

    mkdir -p "$BIN_DIR"
    download_url="https://github.com/tailscale/tailcat/releases/download/v0.4.0/tailcat_0.4.0_linux_${pkg_arch}.tar.gz"
    printf "%b[*] Downloading %s...%b\n" "$C_CYAN" "${download_url}" "$C_RESET"

    if curl -fsSL "$download_url" | tar -xz -C "$BIN_DIR" tailcat; then
        chmod 755 "$TAILCAT_BIN"
        printf "\n%b[+] TailCat binary installed successfully (%s).%b\n" "$C_GREEN" "${pkg_arch}" "$C_RESET"
    else
        printf "\n%b[-] Failed to download TailCat binary.%b\n" "$C_RED" "$C_RESET"
        return 1
    fi
}

# -------------------------------------------------------------------------------------------------------------------------
# Interactive Menu Loop (KISS & Modern UX with Generous Whitespace)

main_menu() {
    while true; do
        active_cnt=$(get_active_service_count)
        if [ "$active_cnt" -gt 0 ]; then
            status_str="${C_GREEN}🟢 ACTIVE — ${active_cnt}/4 Services Running${C_RESET}"
            opt5_badge="${C_GREEN}[${active_cnt} Active]${C_RESET}"
            opt6_badge="${C_RED}[Kill Active]${C_RESET}"
        else
            status_str="${C_GRAY}⚪ INACTIVE${C_RESET}"
            opt5_badge="${C_GRAY}[0 Active]${C_RESET}"
            opt6_badge="${C_GRAY}[Idle]${C_RESET}"
        fi

        b_ssh=$(get_service_badge "SSH")
        b_recv=$(get_service_badge "RECV")
        b_files=$(get_service_badge "FILES")
        b_web=$(get_service_badge "WEBGUI")

        draw_cat

        printf "%b%b========================================================================%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
        printf "  %bTailCat-Merlin v%s%b — Ephemeral WireGuard Tunnel Manager\n" "$C_BOLD" "${VERSION}" "$C_RESET"
        printf "  Status: %b\n" "${status_str}"
        printf "%b========================================================================%b\n\n" "$C_CYAN" "$C_RESET"

        printf "  %b1.%b 🆘 Start Remote Shell           %bInstant Support, No Password/Key%b  %b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET" "$b_ssh"
        printf "  %b2.%b 📥 Receive Files / DropBox      %bDirect P2P File Drop to Router%b    %b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET" "$b_recv"
        printf "  %b3.%b 📁 Share Directory (SFTP)       %bRead-Only / Read-Write Share%b      %b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET" "$b_files"
        printf "  %b4.%b 🌐 Expose Router WebGUI         %bInstant Web Administration Tunnel%b %b\n\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET" "$b_web"

        printf "  %b------------------------------------------------------------------------%b\n\n" "$C_CYAN" "$C_RESET"

        printf "  %b5.%b 👁️ View Active Sessions         %bInstant Token & QR Viewer%b        %b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET" "${opt5_badge}"
        printf "  %b6.%b 🛑 Stop Active Sessions         %bTerminate Running Services%b       %b\n\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET" "${opt6_badge}"

        printf "  %b------------------------------------------------------------------------%b\n\n" "$C_CYAN" "$C_RESET"

        printf "  %b7.%b ⏱️ Configure Auto-Kill Timeout  %bCurrent: %s min%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "${TIMEOUT_MINUTES}" "$C_RESET"
        printf "  %b8.%b 🔄 Reinstall / Update Binary    %bARMv7 / ARM64 Auto-Detect%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"
        printf "  %b9.%b 🗑️ Uninstall TailCat Addon     %bClean up all files%b\n\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"

        printf "%b========================================================================%b\n\n" "$C_CYAN" "$C_RESET"
        printf "  Actions: 1-9 Menu Selection  |  🛑 %bS%btop  |  ⏱️ %bT%bimeout  |  ↩️ %bE%bxit: " "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET"
        if ! read -r choice; then
            break
        fi

        case "$choice" in
            1)
                start_tunnel "SSH" "serve no-auth-ssh" "🆘 Instant Remote Shell"
                ;;
            2)
                printf "\n%bSelect DropBox Destination:%b\n\n" "$C_CYAN" "$C_RESET"
                ram_free=$(get_free_space "/tmp")
                printf "  1. ⚡ Volatile RAM:  /tmp/tailcat-inbox           (Free: %s) [Default]\n" "$ram_free"
                usb_drive=""
                for d in /tmp/mnt/*; do
                    if [ -d "$d" ] && [ "$d" != "/tmp/mnt/*" ]; then
                        usb_drive="$d"
                        break
                    fi
                done
                if [ -n "$usb_drive" ]; then
                    usb_free=$(get_free_space "$usb_drive")
                    printf "  2. 💾 USB Storage:   %s/tailcat-inbox (Free: %s) [Persistent]\n" "$usb_drive" "$usb_free"
                    printf "  3. 📂 Custom Directory Path\n\n"
                    printf " Choice [1-3, Default 1, e to cancel]: "
                else
                    printf "  2. 📂 Custom Directory Path\n\n"
                    printf " Choice [1-2, Default 1, e to cancel]: "
                fi

                if ! read -r d_choice; then
                    continue
                fi
                target_dir="/tmp/tailcat-inbox"
                case "$d_choice" in
                    [eE]|[bB]|cancel|exit)
                        printf "\n%b[*] Operation cancelled.%b\n" "$C_YELLOW" "$C_RESET"
                        continue
                        ;;
                    1|'')
                        target_dir="/tmp/tailcat-inbox"
                        ;;
                    2)
                        if [ -n "$usb_drive" ]; then
                            target_dir="${usb_drive}/tailcat-inbox"
                        else
                            printf "\n Enter custom destination directory (or e to cancel): "
                            if ! read -r user_dir; then
                                continue
                            fi
                            case "$user_dir" in
                                [eE]|[bB]|cancel|exit)
                                    printf "\n%b[*] Operation cancelled.%b\n" "$C_YELLOW" "$C_RESET"
                                    continue
                                    ;;
                                '')
                                    target_dir="/tmp/tailcat-inbox"
                                    ;;
                                *)
                                    target_dir="$user_dir"
                                    ;;
                            esac
                        fi
                        ;;
                    3)
                        if [ -n "$usb_drive" ]; then
                            printf "\n Enter custom destination directory (or e to cancel): "
                            if ! read -r user_dir; then
                                continue
                            fi
                            case "$user_dir" in
                                [eE]|[bB]|cancel|exit)
                                    printf "\n%b[*] Operation cancelled.%b\n" "$C_YELLOW" "$C_RESET"
                                    continue
                                    ;;
                                '')
                                    target_dir="/tmp/tailcat-inbox"
                                    ;;
                                *)
                                    target_dir="$user_dir"
                                    ;;
                            esac
                        else
                            printf "\n%b[!] Invalid selection. Operation cancelled.%b\n" "$C_RED" "$C_RESET"
                            continue
                        fi
                        ;;
                    *)
                        printf "\n%b[!] Invalid selection. Operation cancelled.%b\n" "$C_RED" "$C_RESET"
                        continue
                        ;;
                esac
                mkdir -p "$target_dir"
                start_tunnel "RECV" "recv ${target_dir}" "📥 Encrypted File DropBox" "${target_dir}"
                ;;
            3)
                printf "\n Enter directory path to serve [/jffs, or e to cancel]: "
                if ! read -r s_dir; then
                    continue
                fi
                case "$s_dir" in
                    [eE]|[bB]|cancel|exit)
                        printf "\n%b[*] Operation cancelled.%b\n" "$C_YELLOW" "$C_RESET"
                        continue
                        ;;
                    '')
                        s_dir="/jffs"
                        ;;
                esac
                if [ ! -d "$s_dir" ]; then
                    printf "\n%b[!] Directory %s does not exist.%b\n" "$C_RED" "$s_dir" "$C_RESET"
                    continue
                fi
                printf "\n Permission mode [1=Read-Only (ro), 2=Read-Write (rw), default 1, e to cancel]: "
                if ! read -r p_choice; then
                    continue
                fi
                case "$p_choice" in
                    [eE]|[bB]|cancel|exit)
                        printf "\n%b[*] Operation cancelled.%b\n" "$C_YELLOW" "$C_RESET"
                        continue
                        ;;
                    2)
                        perm_mode="rw"
                        ;;
                    1|''|*)
                        perm_mode="ro"
                        ;;
                esac
                start_tunnel "FILES" "serve --files=${s_dir}:${perm_mode} files" "📁 SFTP File Share (${s_dir})" "Path: ${s_dir} (${perm_mode})"
                ;;
            4)
                https_port=$(nvram get https_lanport 2>/dev/null || echo 8443)
                [ -z "$https_port" ] && https_port=8443
                http_port=$(nvram get http_lanport 2>/dev/null || echo 80)
                [ -z "$http_port" ] && http_port=80
                start_tunnel "WEBGUI" "serve ${https_port},${http_port}" "🌐 Router WebGUI (Ports ${https_port}, ${http_port})" "HTTPS: ${https_port}, HTTP: ${http_port}"
                ;;
            5|[vV])
                interactive_session_card "ALL"
                ;;
            6)
                stop_sessions_menu
                ;;
            [sS])
                stop_all_sessions
                ;;
            7|[tT])
                set_timeout_config
                ;;
            8|[uU])
                update_binary
                ;;
            9)
                printf "\n Are you sure you want to completely remove TailCat? [y/N]: "
                read -r confirm_un
                case "$confirm_un" in
                    [yY]*)
                        stop_all_sessions
                        if [ -f "/jffs/scripts/init-start" ]; then
                            sed -i '/tailcat/d' /jffs/scripts/init-start 2>/dev/null || true
                        fi
                        rm -rf "$CONFIG_DIR" "$SESSIONS_DIR" /jffs/scripts/tailcat /jffs/addons/amtm/tailcat.mod 2>/dev/null || true
                        printf "\n%b[+] TailCat-Merlin has been uninstalled.%b\n" "$C_GREEN" "$C_RESET"
                        exit 0
                        ;;
                esac
                ;;
            [eE])
                printf "\n%bGoodbye!%b\n\n" "$C_CYAN" "$C_RESET"
                exit 0
                ;;
            *)
                printf "\n%b[!] Invalid selection.%b\n" "$C_RED" "$C_RESET"
                ;;
        esac
    done
}

# Ensure binary exists on first run
if [ ! -x "$TAILCAT_BIN" ] && [ "${1:-}" != "--help" ] && [ "${1:-}" != "-h" ]; then
    update_binary || true
fi

main_menu
