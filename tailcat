#!/bin/sh
# =========================================================================================================================
# TailCat-Merlin — Ephemeral WireGuard Tunnel & File Drop Manager for Asuswrt-Merlin
# Managed by AMTM standard conventions.
# =========================================================================================================================
# shellcheck disable=SC2153

set -eu

VERSION="1.1.1"
CONFIG_DIR="/jffs/addons/tailcat"
CONFIG_FILE="${CONFIG_DIR}/tailcat.cfg"
BIN_DIR="${CONFIG_DIR}/bin"
TAILCAT_BIN="${BIN_DIR}/tailcat"
SESSION_FILE="/tmp/tailcat_session.env"
ADDR_FILE="/tmp/tailcat_addr.txt"
LOG_TAG="tailcat-merlin"

# ANSI Color Palette
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_CYAN="\033[1;36m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;37m" # Readable muted white/gray
C_WHITE="\033[1;37m" # Crisp high-contrast white
C_MAGENTA="\033[1;35m"

# Default Configuration
DEFAULT_TIMEOUT=30 # 30 minutes
DERP_URL="https://tailcat.dev/derpmap.json"
export DERP_URL

# Load Config if exists
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

TIMEOUT_MINUTES="${TIMEOUT_MINUTES:-$DEFAULT_TIMEOUT}"

# -------------------------------------------------------------------------------------------------------------------------
# Helper Functions

log_msg() {
    logger -t "$LOG_TAG" "$*"
}

is_session_active() {
    if [ -f "$SESSION_FILE" ]; then
        # shellcheck disable=SC1090
        . "$SESSION_FILE"
        if [ -n "${PID:-}" ] && kill -0 "$PID" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

get_time_left() {
    if is_session_active; then
        # shellcheck disable=SC1090
        . "$SESSION_FILE"
        now=$(date +%s)
        if [ "$now" -lt "${EXPIRE_EPOCH:-0}" ]; then
            remaining=$(( (EXPIRE_EPOCH - now) / 60 ))
            printf "%sm remaining" "$remaining"
            return
        fi
    fi
    printf "Expired"
}

stop_session() {
    if is_session_active; then
        # shellcheck disable=SC1090
        . "$SESSION_FILE"
        if [ -n "${PID:-}" ]; then
            kill -9 "$PID" 2>/dev/null || true
        fi
        if [ -n "${WATCHDOG_PID:-}" ]; then
            kill -9 "$WATCHDOG_PID" 2>/dev/null || true
        fi
        rm -f "$SESSION_FILE" "$ADDR_FILE"
        log_msg "TailCat session stopped: ${SERVICE:-unknown}"
        printf "%b[+] Active TailCat session has been stopped.%b\n" "$C_GREEN" "$C_RESET"
    else
        rm -f "$SESSION_FILE" "$ADDR_FILE"
        printf "%b[!] No active TailCat session found.%b\n" "$C_YELLOW" "$C_RESET"
    fi
}

start_tunnel() {
    service_type="$1"
    subcmd="$2"
    desc="$3"
    extra_info="${4:-}"

    if is_session_active; then
        printf "%b[!] A TailCat session is already active. Stop it first (Option 6 or 's').%b\n" "$C_RED" "$C_RESET"
        return 1
    fi

    if [ ! -x "$TAILCAT_BIN" ]; then
        printf "%b[!] TailCat binary not found at %s.%b\n" "$C_RED" "$TAILCAT_BIN" "$C_RESET"
        printf "%b[*] Please run Option 8 to download/reinstall the binary.%b\n" "$C_YELLOW" "$C_RESET"
        return 1
    fi

    printf "\n%b[*] Starting %s...%b\n" "$C_CYAN" "$desc" "$C_RESET"
    rm -f "$ADDR_FILE"

    # Start tailcat in background with address output file
    # shellcheck disable=SC2086
    TAILCAT_ADDR_FILE="$ADDR_FILE" "$TAILCAT_BIN" $subcmd >/dev/null 2>&1 &
    tailcat_pid=$!

    # Wait up to 10 seconds for address file
    count=0
    while [ $count -lt 10 ]; do
        if [ -s "$ADDR_FILE" ]; then
            break
        fi
        sleep 1
        count=$((count + 1))
    done

    if [ ! -s "$ADDR_FILE" ] || ! kill -0 "$tailcat_pid" 2>/dev/null; then
        printf "%b[-] Failed to start TailCat session.%b\n" "$C_RED" "$C_RESET"
        kill -9 "$tailcat_pid" 2>/dev/null || true
        rm -f "$ADDR_FILE"
        return 1
    fi

    token=$(tr -d '\r\n' < "$ADDR_FILE")
    now=$(date +%s)
    timeout_sec=$(( TIMEOUT_MINUTES * 60 ))
    expire_epoch=$(( now + timeout_sec ))

    # Launch Auto-Kill Watcher Subshell
    (
        sleep "$timeout_sec"
        if kill -0 "$tailcat_pid" 2>/dev/null; then
            kill -9 "$tailcat_pid" 2>/dev/null || true
            rm -f "$SESSION_FILE" "$ADDR_FILE"
            logger -t "$LOG_TAG" "Session ${service_type} auto-expired after ${TIMEOUT_MINUTES}m"
        fi
    ) &
    watchdog_pid=$!

    # Save Session State
    cat <<EOF > "$SESSION_FILE"
PID=${tailcat_pid}
WATCHDOG_PID=${watchdog_pid}
SERVICE="${service_type}"
DESC="${desc}"
TOKEN="${token}"
EXTRA_INFO="${extra_info}"
START_EPOCH=${now}
EXPIRE_EPOCH=${expire_epoch}
TIMEOUT_MINUTES=${TIMEOUT_MINUTES}
EOF

    log_msg "TailCat session started: ${service_type} (Auto-kill: ${TIMEOUT_MINUTES}m)"
    interactive_session_card
}

get_client_connect_cmd() {
    s_type="$1"
    s_token="$2"
    s_extra="${3:-}"

    case "$s_type" in
        "SSH")
            printf "tailcat ssh %s" "$s_token"
            ;;
        "RECV")
            printf "tailcat cp <file_or_dir> %s:" "$s_token"
            ;;
        "FILES")
            printf "tailcat ls -l %s" "$s_token"
            ;;
        "WEBGUI")
            printf "tailcat socks %s curl -k https://router.tailcat:%s/" "$s_token" "${s_extra:-8443}"
            ;;
        *)
            printf "tailcat %s" "$s_token"
            ;;
    esac
}

render_session_card() {
    show_qr="${1:-0}"
    if ! is_session_active; then
        printf "\n%b[!] No active TailCat session.%b\n" "$C_YELLOW" "$C_RESET"
        return 1
    fi

    # shellcheck disable=SC1090,SC2153
    . "$SESSION_FILE"
    time_left=$(get_time_left)
    cmd=$(get_client_connect_cmd "$SERVICE" "$TOKEN" "${EXTRA_INFO:-}")

    printf "\n%b┌────────────────────────────────────────────────────────────────────────┐%b\n" "$C_GREEN" "$C_RESET"
    printf "%b│  %b🐱 TailCat-Merlin — Live Active Session Card%b%b                          │%b\n" "$C_GREEN" "$C_BOLD" "$C_RESET" "$C_GREEN" "$C_RESET"
    printf "%b├────────────────────────────────────────────────────────────────────────┤%b\n" "$C_GREEN" "$C_RESET"
    printf "  %bService:%b       %b%s%b\n" "$C_BOLD" "$C_RESET" "$C_MAGENTA" "${DESC}" "$C_RESET"
    if [ -n "${EXTRA_INFO:-}" ]; then
        printf "  %bDestination:%b   %s\n" "$C_BOLD" "$C_RESET" "${EXTRA_INFO}"
    fi
    printf "  %bAuto-Kill:%b     %b⏱️  %s (Configured Limit: %s min)%b\n" "$C_BOLD" "$C_RESET" "$C_YELLOW" "${time_left}" "${TIMEOUT_MINUTES}" "$C_RESET"
    printf "  %bSecurity:%b      %b🔒 WireGuard P2P Encrypted (Zero WAN Ports Open)%b\n\n" "$C_BOLD" "$C_RESET" "$C_GREEN" "$C_RESET"
    printf "  %bShareable Capability Token:%b\n" "$C_BOLD" "$C_RESET"
    printf "  %b%b%s%b\n\n" "$C_BOLD" "$C_YELLOW" "${TOKEN}" "$C_RESET"
    printf "  %bClient Connect Command:%b\n" "$C_BOLD" "$C_RESET"
    printf "  %b👉 %s%b\n\n" "$C_CYAN" "$cmd" "$C_RESET"

    # Chat Invite Snippet (High-contrast for dark/light terminal themes)
    printf "  %b💬 Copy & Paste to Friend / Admin Support:%b\n" "$C_BOLD" "$C_RESET"
    printf "  %b┌────────────────────────────────────────────────────────────────────┐%b\n" "$C_CYAN" "$C_RESET"
    printf "  %b│ %bHey, I've opened a temporary TailCat session on my router (%s).%b%b  │%b\n" "$C_CYAN" "$C_WHITE" "${time_left}" "$C_RESET" "$C_CYAN" "$C_RESET"
    printf "  %b│ %bRun: %b%-57s%b%b │%b\n" "$C_CYAN" "$C_WHITE" "$C_YELLOW" "$cmd" "$C_RESET" "$C_CYAN" "$C_RESET"
    printf "  %b└────────────────────────────────────────────────────────────────────┘%b\n" "$C_CYAN" "$C_RESET"

    # ASCII QR Code if qrencode exists and requested/supported
    if [ "$show_qr" = "1" ] && [ -x "/usr/sbin/qrencode" ]; then
        printf "\n  %b📱 Scan QR Code on Mobile / Laptop:%b\n" "$C_BOLD" "$C_RESET"
        /usr/sbin/qrencode -t UTF8 -m 1 "$cmd" 2>/dev/null || /usr/sbin/qrencode -t ASCII -m 1 "$cmd" 2>/dev/null || true
    fi

    printf "%b└────────────────────────────────────────────────────────────────────────┘%b\n" "$C_GREEN" "$C_RESET"
    return 0
}

interactive_session_card() {
    show_qr=0
    while is_session_active; do
        render_session_card "$show_qr"
        qr_hint="[q] 📱 Show QR"
        [ "$show_qr" = "1" ] && qr_hint="[q] 📱 Hide QR"

        printf "  %bActions:%b [s] 🛑 Stop Session  |  [r] 🔄 Refresh  |  %s  |  [b] ↩️ Main Menu\n" "$C_BOLD" "$C_RESET" "$qr_hint"
        printf "  Select action [s/r/q/b, default b]: "
        if ! read -r s_action; then
            break
        fi
        case "$s_action" in
            [sS])
                stop_session
                break
                ;;
            [rR])
                # Refreshes card in loop
                ;;
            [qQ])
                if [ "$show_qr" = "1" ]; then
                    show_qr=0
                else
                    show_qr=1
                fi
                ;;
            [bB]|''|[eE])
                break
                ;;
            *)
                break
                ;;
        esac
    done
}

set_timeout_config() {
    printf "\n%bConfigure Session Auto-Kill Timeout%b\n" "$C_CYAN" "$C_RESET"
    printf "Current Timeout: %b%s minutes%b\n\n" "$C_BOLD" "${TIMEOUT_MINUTES}" "$C_RESET"
    printf "Enter new timeout in minutes [5-240] (default 30): "
    read -r user_t
    case "$user_t" in
        ''|*[!0-9]*)
            if [ -z "$user_t" ]; then
                user_t=30
            else
                printf "%b[!] Invalid number. Setting unchanged.%b\n" "$C_RED" "$C_RESET"
                return
            fi
            ;;
    esac

    if [ "$user_t" -lt 5 ] || [ "$user_t" -gt 240 ]; then
        printf "%b[!] Timeout must be between 5 and 240 minutes.%b\n" "$C_RED" "$C_RESET"
        return
    fi

    TIMEOUT_MINUTES="$user_t"
    mkdir -p "$CONFIG_DIR"
    echo "TIMEOUT_MINUTES=${TIMEOUT_MINUTES}" > "$CONFIG_FILE"
    printf "%b[+] Timeout updated to %s minutes.%b\n" "$C_GREEN" "${TIMEOUT_MINUTES}" "$C_RESET"
}

update_binary() {
    printf "\n%b[*] Checking router architecture & downloading official TailCat binary...%b\n" "$C_CYAN" "$C_RESET"
    arch=$(uname -m)
    pkg_arch=""
    case "$arch" in
        armv7*|armv6*|arm) pkg_arch="armv7" ;;
        aarch64*|arm64*)  pkg_arch="arm64" ;;
        *)
            printf "%b[!] Unsupported router architecture: %s%b\n" "$C_RED" "${arch}" "$C_RESET"
            return 1
            ;;
    esac

    mkdir -p "$BIN_DIR"
    download_url="https://github.com/tailscale/tailcat/releases/download/v0.4.0/tailcat_0.4.0_linux_${pkg_arch}.tar.gz"
    printf "%b[*] Downloading %s...%b\n" "$C_CYAN" "${download_url}" "$C_RESET"

    if curl -fsSL "$download_url" | tar -xz -C "$BIN_DIR" tailcat; then
        chmod 755 "$TAILCAT_BIN"
        printf "%b[+] TailCat binary installed successfully (%s).%b\n" "$C_GREEN" "${pkg_arch}" "$C_RESET"
    else
        printf "%b[-] Failed to download TailCat binary.%b\n" "$C_RED" "$C_RESET"
        return 1
    fi
}

# -------------------------------------------------------------------------------------------------------------------------
# Interactive Menu Loop (KISS & Modern UX)

main_menu() {
    while true; do
        status_str="${C_GRAY}[ INACTIVE ]${C_RESET}"
        if is_session_active; then
            # shellcheck disable=SC1090
            . "$SESSION_FILE"
            tl=$(get_time_left)
            status_str="${C_GREEN}[ ACTIVE: ${SERVICE} | ${tl} ] [Press '5' or 's']${C_RESET}"
        fi

        printf "\n%b%b========================================================================%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
        printf "  %bTailCat-Merlin v%s%b — Ephemeral WireGuard Tunnel Manager\n" "$C_BOLD" "${VERSION}" "$C_RESET"
        printf "  Status: %b\n" "${status_str}"
        printf "%b========================================================================%b\n" "$C_CYAN" "$C_RESET"
        printf "  %b1.%b 🆘 Start Remote Shell           %b(Instant Support, No Password/Key)%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"
        printf "  %b2.%b 📥 Receive Files / DropBox      %b(Direct P2P File Drop to Router)%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"
        printf "  %b3.%b 📤 Share Directory (SFTP)       %b(Read-Only / Read-Write Share)%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"
        printf "  %b4.%b 🌐 Expose Router WebGUI         %b(Instant Web Administration Tunnel)%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"
        printf "  %b5.%b 👁️ View Active Session Card    %b(Live Timer, QR Code & Chat Snippet)%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"
        printf "  %b6.%b 🛑 Stop Active Session          %b(Kill active tunnel)%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"
        printf "  %b------------------------------------------------------------------------%b\n" "$C_CYAN" "$C_RESET"
        printf "  %b7.%b ⏱️ Configure Auto-Kill Timeout  %b(Current: %s min)%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "${TIMEOUT_MINUTES}" "$C_RESET"
        printf "  %b8.%b 🔄 Reinstall / Update Binary    %b(Download latest v0.4.0)%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"
        printf "  %b9.%b 🗑️ Uninstall TailCat Addon     %b(Clean up all files)%b\n" "$C_BOLD" "$C_RESET" "$C_GRAY" "$C_RESET"
        printf "%b========================================================================%b\n" "$C_CYAN" "$C_RESET"
        printf " Enter selection [1-9, s=Stop, t=Timeout, e=Exit]: "
        if ! read -r choice; then
            break
        fi

        case "$choice" in
            1)
                start_tunnel "SSH" "serve no-auth-ssh" "Instant Remote Shell (Passwordless)"
                ;;
            2)
                printf "\n%bSelect DropBox Destination:%b\n" "$C_CYAN" "$C_RESET"
                printf "  1. Volatile RAM: /tmp/tailcat-inbox [Default]\n"
                usb_drive=""
                for d in /tmp/mnt/*; do
                    if [ -d "$d" ] && [ "$d" != "/tmp/mnt/*" ]; then
                        usb_drive="$d"
                        break
                    fi
                done
                if [ -n "$usb_drive" ]; then
                    printf "  2. USB Storage: %s/tailcat-inbox [Persistent]\n" "$usb_drive"
                fi
                printf "  3. Custom Directory Path\n"
                printf " Choice [1-3, Default 1]: "
                read -r d_choice
                target_dir="/tmp/tailcat-inbox"
                case "$d_choice" in
                    2)
                        if [ -n "$usb_drive" ]; then
                            target_dir="${usb_drive}/tailcat-inbox"
                        fi
                        ;;
                    3)
                        printf " Enter custom destination directory: "
                        read -r user_dir
                        if [ -n "$user_dir" ]; then
                            target_dir="$user_dir"
                        fi
                        ;;
                esac
                mkdir -p "$target_dir"
                start_tunnel "RECV" "recv ${target_dir}" "Encrypted File DropBox" "${target_dir}"
                ;;
            3)
                printf "\n Enter directory path to serve [/jffs]: "
                read -r s_dir
                s_dir="${s_dir:-/jffs}"
                if [ ! -d "$s_dir" ]; then
                    printf "%b[!] Directory %s does not exist.%b\n" "$C_RED" "$s_dir" "$C_RESET"
                else
                    printf " Permission mode [1=Read-Only (ro), 2=Read-Write (rw), default 1]: "
                    read -r p_choice
                    perm_mode="ro"
                    if [ "$p_choice" = "2" ]; then
                        perm_mode="rw"
                    fi
                    start_tunnel "FILES" "serve --files=${s_dir}:${perm_mode} files" "SFTP File Share (${s_dir})" "Path: ${s_dir} (${perm_mode})"
                fi
                ;;
            4)
                https_port=$(nvram get https_lanport 2>/dev/null || echo 8443)
                [ -z "$https_port" ] && https_port=8443
                http_port=$(nvram get http_lanport 2>/dev/null || echo 80)
                [ -z "$http_port" ] && http_port=80
                start_tunnel "WEBGUI" "serve ${https_port},${http_port}" "Router WebGUI (Ports ${https_port}, ${http_port})" "HTTPS: ${https_port}, HTTP: ${http_port}"
                ;;
            5|[vV])
                interactive_session_card
                ;;
            6|[sS])
                stop_session
                ;;
            7|[tT])
                set_timeout_config
                ;;
            8|[uU])
                update_binary
                ;;
            9)
                printf " Are you sure you want to completely remove TailCat? [y/N]: "
                read -r confirm_un
                case "$confirm_un" in
                    [yY]*)
                        stop_session
                        if [ -f "/jffs/scripts/init-start" ]; then
                            sed -i '/tailcat_session/d' /jffs/scripts/init-start 2>/dev/null || true
                        fi
                        rm -rf "$CONFIG_DIR" /jffs/scripts/tailcat /jffs/addons/amtm/tailcat.mod 2>/dev/null || true
                        printf "%b[+] TailCat-Merlin has been uninstalled.%b\n" "$C_GREEN" "$C_RESET"
                        exit 0
                        ;;
                esac
                ;;
            [eE])
                printf "%bGoodbye!%b\n" "$C_CYAN" "$C_RESET"
                exit 0
                ;;
            *)
                printf "%b[!] Invalid selection.%b\n" "$C_RED" "$C_RESET"
                ;;
        esac
    done
}

# Ensure binary exists on first run
if [ ! -x "$TAILCAT_BIN" ] && [ "${1:-}" != "--help" ] && [ "${1:-}" != "-h" ]; then
    update_binary || true
fi

main_menu
