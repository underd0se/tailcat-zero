#!/bin/sh
# =========================================================================================================================
# TAILCAT ZER0 — Ephemeral WireGuard Tunnel & Multi-Service Manager for Asuswrt-Merlin
# =========================================================================================================================
# shellcheck disable=SC2153

set -eu

VERSION="1.4.0"
CONFIG_DIR="/jffs/addons/tailcat"
CONFIG_FILE="${CONFIG_DIR}/tailcat.cfg"
BIN_DIR="${CONFIG_DIR}/bin"
TAILCAT_BIN="${BIN_DIR}/tailcat"
SESSIONS_DIR="/tmp/tailcat_sessions"
LOG_TAG="tailcatzero"

# ANSI Color Palette
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_KEY="\033[1;4m" # Bold + Underline for hotkeys
C_GREEN="\033[1;32m"
C_CYAN="\033[1;36m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;37m" # Readable muted white/gray
C_WHITE="\033[1;37m" # Crisp high-contrast white
C_MAGENTA="\033[1;35m"

trap 'printf "%b" "$C_RESET" 2>/dev/null || true' EXIT INT TERM

# Default Configuration
DEFAULT_TIMEOUT=30 # 30 minutes
DERP_URL="https://tailcat.dev/derpmap.json"
export DERP_URL

# Load Config if exists
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

TIMEOUT_MINUTES="${TIMEOUT_MINUTES:-$DEFAULT_TIMEOUT}"
mkdir -p "$SESSIONS_DIR"
FLASH_MSG=""

# -------------------------------------------------------------------------------------------------------------------------
# Helper Functions

clear_screen() {
    if [ -t 1 ]; then
        printf "\033[2J\033[H"
    fi
}

log_msg() {
    logger -t "$LOG_TAG" "$*"
}

is_service_active() {
    s_id="$1"
    s_file="${SESSIONS_DIR}/${s_id}.env"
    if [ -f "$s_file" ]; then
        # shellcheck disable=SC1090
        . "$s_file"
        if [ -n "${PID:-}" ] && kill -0 "$PID" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

has_any_active_session() {
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            return 0
        fi
    done
    return 1
}

get_active_service_count() {
    cnt=0
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            cnt=$((cnt + 1))
        fi
    done
    echo "$cnt"
}

get_free_space() {
    target_path="$1"
    if [ -d "$target_path" ]; then
        df -h "$target_path" 2>/dev/null | awk 'NR==2 {print $4}' || echo "N/A"
    else
        echo "N/A"
    fi
}

get_service_time_left() {
    s_id="$1"
    s_file="${SESSIONS_DIR}/${s_id}.env"
    if is_service_active "$s_id"; then
        # shellcheck disable=SC1090
        . "$s_file"
        if [ "${EXPIRE_EPOCH:-0}" -eq 0 ]; then
            printf "Persistent"
            return
        fi
        now=$(date +%s)
        if [ "$now" -lt "${EXPIRE_EPOCH:-0}" ]; then
            diff=$(( EXPIRE_EPOCH - now ))
            if [ "$diff" -lt 60 ]; then
                printf "< 1m remaining"
                return
            fi
            remaining=$(( diff / 60 ))
            printf "%sm remaining" "$remaining"
            return
        fi
    fi
    printf "Expired"
}

get_service_badge() {
    s_id="$1"
    if is_service_active "$s_id"; then
        tl=$(get_service_time_left "$s_id")
        printf "%b[🟢 Active: %s]%b" "$C_GREEN" "$tl" "$C_RESET"
    else
        printf "%b[⚪ Inactive]%b" "$C_GRAY" "$C_RESET"
    fi
}

stop_single_session() {
    s_id="$1"
    s_file="${SESSIONS_DIR}/${s_id}.env"
    addr_file="/tmp/tailcat_addr_${s_id}.txt"
    if [ -f "$s_file" ]; then
        # shellcheck disable=SC1090
        . "$s_file"
        if [ -n "${PID:-}" ]; then
            kill -9 "$PID" 2>/dev/null || true
            wait "$PID" 2>/dev/null || true
        fi
        if [ -n "${WATCHDOG_PID:-}" ]; then
            kill -9 "$WATCHDOG_PID" 2>/dev/null || true
            wait "$WATCHDOG_PID" 2>/dev/null || true
        fi
        rm -f "$s_file" "$addr_file"
        log_msg "TailCat session stopped: ${s_id}"
        printf "\n%b[+] Stopped session: %s%b\n" "$C_GREEN" "${DESC:-$s_id}" "$C_RESET"
    else
        rm -f "$s_file" "$addr_file"
    fi
}

stop_all_sessions() {
    found=0
    for s in SSH RECV FILES WEBGUI; do
        if [ -f "${SESSIONS_DIR}/${s}.env" ]; then
            stop_single_session "$s"
            found=1
        fi
    done
    if [ "$found" = "0" ]; then
        printf "\n%b[!] No active TailCat sessions found.%b\n" "$C_YELLOW" "$C_RESET"
    fi
}

stop_sessions_with_confirmation() {
    count=$(get_active_service_count)
    if [ "$count" -eq 0 ]; then
        FLASH_MSG="${C_YELLOW}[!] No active TailCat sessions are currently running.${C_RESET}"
        return
    fi

    clear_screen
    draw_header
    printf "  %b%b🛑 Running TailCat Processes (%d Active):%b\n\n" "$C_CYAN" "$C_BOLD" "$count" "$C_RESET"

    svc_1=""
    svc_2=""
    svc_3=""
    svc_4=""
    idx=1
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            eval "svc_${idx}=\"\$s\""
            s_file="${SESSIONS_DIR}/${s}.env"
            # shellcheck disable=SC1090
            . "$s_file"
            tl=$(get_service_time_left "$s")
            printf "  %b%d.%b %b%-30s%b %b(PID: %s, %s)%b\n" "$C_BOLD" "$idx" "$C_RESET" "$C_CYAN" "${DESC}" "$C_RESET" "$C_GRAY" "${PID:-unknown}" "$tl" "$C_RESET"
            idx=$((idx + 1))
        fi
    done

    printf "\n%b%b========================================================================%b\n\n" "$C_CYAN" "$C_BOLD" "$C_RESET"

    if [ "$count" -gt 1 ]; then
        printf "   Choice [1-%d=Stop individual, a=Stop All, e to cancel]: " "$count"
    else
        printf "   Stop this session? [1/y=Stop, e to cancel]: "
    fi

    if ! read -r confirm_stop; then
        FLASH_MSG="${C_YELLOW}[*] Operation cancelled.${C_RESET}"
        return
    fi

    case "$confirm_stop" in
        [aA]|[aA][lL][lL]|[yY]|[yY][eE][sS])
            stop_all_sessions
            FLASH_MSG="${C_GREEN}[+] All active TailCat sessions stopped.${C_RESET}"
            ;;
        1|2|3|4)
            target_svc=""
            case "$confirm_stop" in
                1) target_svc="$svc_1" ;;
                2) target_svc="$svc_2" ;;
                3) target_svc="$svc_3" ;;
                4) target_svc="$svc_4" ;;
            esac
            if [ -n "$target_svc" ]; then
                s_file="${SESSIONS_DIR}/${target_svc}.env"
                svc_desc="$target_svc"
                if [ -f "$s_file" ]; then
                    # shellcheck disable=SC1090
                    . "$s_file"
                    svc_desc="${DESC:-$target_svc}"
                fi
                stop_single_session "$target_svc"
                FLASH_MSG="${C_GREEN}[+] Stopped ${svc_desc}.${C_RESET}"
            else
                FLASH_MSG="${C_RED}[!] Invalid selection.${C_RESET}"
            fi
            ;;
        [eE]|[bB]|cancel|exit|'')
            FLASH_MSG="${C_YELLOW}[*] Operation cancelled.${C_RESET}"
            ;;
        *)
            FLASH_MSG="${C_RED}[!] Invalid selection.${C_RESET}"
            ;;
    esac
}

get_qrencode_cmd() {
    if command -v qrencode >/dev/null 2>&1; then
        echo "qrencode"
    elif [ -x "/usr/sbin/qrencode" ]; then
        echo "/usr/sbin/qrencode"
    elif [ -x "/opt/bin/qrencode" ]; then
        echo "/opt/bin/qrencode"
    else
        echo ""
    fi
}

ensure_dependencies() {
    # 1. Engine binary
    if [ ! -x "$TAILCAT_BIN" ]; then
        update_binary || true
    fi

    # 2. QR code engine (auto-install if opkg available)
    qr_bin=$(get_qrencode_cmd)
    if [ -z "$qr_bin" ] && [ -x "/opt/bin/opkg" ]; then
        /opt/bin/opkg update >/dev/null 2>&1 || true
        /opt/bin/opkg install qrencode >/dev/null 2>&1 || true
    fi
}

get_binary_version() {
    if [ -x "$TAILCAT_BIN" ]; then
        b_ver=$("$TAILCAT_BIN" --version 2>/dev/null | head -n 1 | tr -d '\r\n' || true)
        if [ -n "$b_ver" ]; then
            printf "%s" "$b_ver"
            return
        fi
    fi
    printf "v%s" "$VERSION"
}

draw_header() {
    printf "  %b%bTAILCAT ZER0 v%s%b              %b╱|、%b\n" "$C_CYAN" "$C_BOLD" "${VERSION}" "$C_RESET" "$C_CYAN" "$C_RESET"
    printf "                                 %b(˚ˎ 。7%b\n" "$C_CYAN" "$C_RESET"
    printf "                                  %b|、˜〵%b\n" "$C_CYAN" "$C_RESET"
    printf "  %bInstant Tunnel Manager%b         %bじしˍ,)ノ%b\n\n" "$C_GRAY" "$C_RESET" "$C_CYAN" "$C_RESET"
    printf "%b%b========================================================================%b\n\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
}

start_tunnel() {
    service_type="$1"
    subcmd="$2"
    desc="$3"
    extra_info="${4:-}"
    interactive_mode="${5:-1}"

    if is_service_active "$service_type"; then
        if [ "$interactive_mode" = "0" ]; then
            printf "\n%b[*] %s is already running.%b\n" "$C_YELLOW" "$desc" "$C_RESET"
            render_single_session_card "$service_type" 0
            return 0
        fi
        clear_screen
        draw_header
        printf "  %b[*] %s is already running.%b\n\n" "$C_YELLOW" "$desc" "$C_RESET"
        printf "    1. View connect card & QR code\n"
        printf "    2. Stop this session\n"
        printf "    3. Restart session\n\n"
        printf "   Choice [1-3, default 1, e to cancel]: "
        if ! read -r act_choice; then
            return
        fi
        case "$act_choice" in
            1|'')
                interactive_session_card "$service_type"
                return
                ;;
            2)
                stop_single_session "$service_type"
                FLASH_MSG="${C_GREEN}[+] Stopped ${desc}.${C_RESET}"
                return
                ;;
            3)
                stop_single_session "$service_type"
                ;;
            *)
                FLASH_MSG="${C_YELLOW}[*] Operation cancelled.${C_RESET}"
                return
                ;;
        esac
    fi

    if [ ! -x "$TAILCAT_BIN" ]; then
        FLASH_MSG="${C_RED}[!] TailCat engine binary not found. Please run Option 6 (Manage TAILCAT ZER0) to install it.${C_RESET}"
        return 1
    fi

    mkdir -p "$SESSIONS_DIR"
    addr_file="/tmp/tailcat_addr_${service_type}.txt"
    rm -f "$addr_file"

    printf "\n%b[*] Starting %s...%b\n" "$C_CYAN" "$desc" "$C_RESET"

    # Start tailcat in background with address output file and guaranteed ephemeral key
    # shellcheck disable=SC2086
    TAILCAT_ADDR_FILE="$addr_file" "$TAILCAT_BIN" --key=new $subcmd >/dev/null 2>&1 &
    tailcat_pid=$!

    # Wait up to 10 seconds for address file
    count=0
    while [ $count -lt 10 ]; do
        if [ -s "$addr_file" ]; then
            break
        fi
        sleep 1
        count=$((count + 1))
    done

    if [ ! -s "$addr_file" ] || ! kill -0 "$tailcat_pid" 2>/dev/null; then
        printf "\n%b[-] Failed to start %s.%b\n" "$C_RED" "$desc" "$C_RESET"
        kill -9 "$tailcat_pid" 2>/dev/null || true
        rm -f "$addr_file"
        return 1
    fi

    token=$(tr -d '\r\n' < "$addr_file")
    now=$(date +%s)
    session_file="${SESSIONS_DIR}/${service_type}.env"
    watchdog_pid=""

    if [ "$TIMEOUT_MINUTES" -gt 0 ]; then
        timeout_sec=$(( TIMEOUT_MINUTES * 60 ))
        expire_epoch=$(( now + timeout_sec ))

        # Launch Auto-Kill Watcher Subshell for this specific service
        (
            sleep "$timeout_sec"
            if kill -0 "$tailcat_pid" 2>/dev/null; then
                kill -9 "$tailcat_pid" 2>/dev/null || true
                rm -f "$session_file" "$addr_file"
                logger -t "$LOG_TAG" "Session ${service_type} auto-expired after ${TIMEOUT_MINUTES}m"
            fi
        ) &
        watchdog_pid=$!
        log_msg "TailCat session started: ${service_type} (Auto-kill: ${TIMEOUT_MINUTES}m)"
    else
        expire_epoch=0
        log_msg "TailCat session started: ${service_type} (Persistent / No Auto-Kill)"
    fi

    # Save Session State
    cat <<EOF > "$session_file"
PID=${tailcat_pid}
WATCHDOG_PID=${watchdog_pid}
SERVICE_ID="${service_type}"
DESC="${desc}"
TOKEN="${token}"
EXTRA_INFO="${extra_info}"
START_EPOCH=${now}
EXPIRE_EPOCH=${expire_epoch}
TIMEOUT_MINUTES=${TIMEOUT_MINUTES}
EOF

    if [ "$interactive_mode" = "1" ]; then
        interactive_session_card "$service_type"
    else
        render_single_session_card "$service_type" 0
    fi
}

get_client_connect_cmd() {
    s_type="$1"
    s_token="$2"

    case "$s_type" in
        "SSH")
            printf "tailcat ssh %s" "$s_token"
            ;;
        "RECV")
            printf "tailcat cp <file_or_dir> %s:" "$s_token"
            ;;
        "FILES")
            printf "tailcat ls -l %s" "$s_token"
            ;;
        "WEBGUI")
            printf "tailcat socks %s" "$s_token"
            ;;
        *)
            printf "tailcat %s" "$s_token"
            ;;
    esac
}

render_multi_session_overview() {
    draw_header
    cnt=$(get_active_service_count)
    printf "%b%b========================================================================%b\n" "$C_GREEN" "$C_BOLD" "$C_RESET"
    printf "  %b%b🐱 TAILCAT ZER0 — Active Sessions (%d Running)%b\n" "$C_CYAN" "$C_BOLD" "$cnt" "$C_RESET"
    printf "%b========================================================================%b\n\n" "$C_GREEN" "$C_RESET"

    idx=1
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            s_file="${SESSIONS_DIR}/${s}.env"
            # shellcheck disable=SC1090
            . "$s_file"
            tl=$(get_service_time_left "$s")
            printf "  %b[%d]%b %b%-28s%b ⏱️  %-14s 🔒 P2P\n" "$C_BOLD" "$idx" "$C_RESET" "$C_MAGENTA" "${DESC}" "$C_RESET" "$tl"
            idx=$((idx + 1))
        fi
    done

    printf "\n  %b💬 Copy & Paste Connect Commands:%b\n" "$C_BOLD" "$C_RESET"
    printf "  %b────────────────────────────────────────────────────────────────────────%b\n" "$C_CYAN" "$C_RESET"
    for s in SSH RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            s_file="${SESSIONS_DIR}/${s}.env"
            # shellcheck disable=SC1090
            . "$s_file"
            cmd=$(get_client_connect_cmd "$s" "$TOKEN")
            if [ "$s" = "WEBGUI" ]; then
                printf "  • %bWebGUI:%b  %btailcat socks %s%b (Open https://localhost:8443)\n" "$C_BOLD" "$C_RESET" "$C_YELLOW" "$TOKEN" "$C_RESET"
            else
                printf "  • %b%-7s%b %b%s%b\n" "$C_BOLD" "${s}:" "$C_RESET" "$C_YELLOW" "$cmd" "$C_RESET"
            fi
        fi
    done
    printf "  %b────────────────────────────────────────────────────────────────────────%b\n\n" "$C_CYAN" "$C_RESET"
    printf "%b========================================================================%b\n\n" "$C_GREEN" "$C_RESET"
}

render_single_session_card() {
    s_id="$1"
    show_qr="${2:-0}"
    s_file="${SESSIONS_DIR}/${s_id}.env"

    if ! is_service_active "$s_id"; then
        printf "\n%b[!] Session %s is not active.%b\n" "$C_YELLOW" "$s_id" "$C_RESET"
        return 1
    fi

    # shellcheck disable=SC1090
    . "$s_file"
    time_left=$(get_service_time_left "$s_id")
    cmd=$(get_client_connect_cmd "$s_id" "$TOKEN")

    draw_header

    printf "%b%b========================================================================%b\n" "$C_GREEN" "$C_BOLD" "$C_RESET"
    printf "  %b%b🐱 TAILCAT ZER0 — Active Session%b\n" "$C_CYAN" "$C_BOLD" "$C_RESET"
    printf "%b========================================================================%b\n\n" "$C_GREEN" "$C_RESET"

    printf "  %bService:%b     %b%s%b\n" "$C_BOLD" "$C_RESET" "$C_MAGENTA" "${DESC}" "$C_RESET"
    if [ -n "${EXTRA_INFO:-}" ]; then
        printf "  %bDestination:%b %s\n" "$C_BOLD" "$C_RESET" "${EXTRA_INFO}"
    fi
    if [ "${time_left}" = "Persistent" ]; then
        auto_kill_str="Disabled (Persistent)"
        invite_str="Hey, I've opened a secure TailCat session on my router."
    else
        auto_kill_str="${time_left}"
        invite_str="Hey, I've opened a temporary TailCat session on my router (${time_left})."
    fi
    printf "  %bAuto-Kill:%b   %b⏱️  %s%b\n" "$C_BOLD" "$C_RESET" "$C_YELLOW" "${auto_kill_str}" "$C_RESET"
    printf "  %bSecurity:%b    %b🔒 WireGuard P2P Encrypted (Zero WAN Ports Open)%b\n\n" "$C_BOLD" "$C_RESET" "$C_GREEN" "$C_RESET"

    printf "  %b💬 Copy & Paste to Friend / Admin Support:%b\n" "$C_BOLD" "$C_RESET"
    printf "  %b────────────────────────────────────────────────────────────────────────%b\n" "$C_CYAN" "$C_RESET"
    printf "  %b%s%b\n" "$C_WHITE" "${invite_str}" "$C_RESET"
    if [ "$s_id" = "WEBGUI" ]; then
        web_port="8443"
        case "${EXTRA_INFO:-}" in
            *HTTPS:\ 8443*|*8443*) web_port="8443" ;;
            *HTTPS:\ *|*HTTP:\ *) web_port=$(echo "${EXTRA_INFO}" | grep -oE '[0-9]+' | head -n1 || echo "8443") ;;
        esac
        printf "  %b1. Run: %btailcat socks %s%b\n" "$C_WHITE" "$C_YELLOW" "$TOKEN" "$C_RESET"
        printf "  %b2. Open browser: %bhttps://localhost:%s%b\n" "$C_WHITE" "$C_CYAN" "${web_port}" "$C_RESET"
    else
        printf "  %bRun: %b%s%b\n" "$C_WHITE" "$C_YELLOW" "$cmd" "$C_RESET"
    fi
    printf "  %b────────────────────────────────────────────────────────────────────────%b\n\n" "$C_CYAN" "$C_RESET"

    qr_bin=$(get_qrencode_cmd)
    if [ "$show_qr" = "1" ]; then
        if [ -n "$qr_bin" ]; then
            printf "  %b📱 Scan QR Code on Mobile / Laptop:%b\n\n" "$C_BOLD" "$C_RESET"
            "$qr_bin" -t UTF8 -m 1 "$cmd" 2>/dev/null || "$qr_bin" -t ASCII -m 1 "$cmd" 2>/dev/null || true
            printf "\n"
        else
            printf "  %b[!] 'qrencode' not found. Install via Entware: 'opkg install qrencode'%b\n\n" "$C_YELLOW" "$C_RESET"
        fi
    fi

    printf "%b========================================================================%b\n\n" "$C_GREEN" "$C_RESET"
    return 0
}

interactive_session_card() {
    cur_svc="${1:-ALL}"
    show_qr=0

    while has_any_active_session; do
        clear_screen

        active_cnt=$(get_active_service_count)
        if [ "$cur_svc" != "ALL" ] && ! is_service_active "$cur_svc"; then
            cur_svc="ALL"
        fi

        if [ "$cur_svc" = "ALL" ] && [ "$active_cnt" -eq 1 ]; then
            for s in SSH RECV FILES WEBGUI; do
                if is_service_active "$s"; then
                    cur_svc="$s"
                    break
                fi
            done
        fi

        if [ "$cur_svc" = "ALL" ]; then
            render_multi_session_overview
            printf "  Actions: 1-%d View/QR  |  🛑 %bS%btop All  |  🔄 %bR%befresh  |  ↩️ %bM%bain Menu: " "$active_cnt" "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET"
            if ! read -r act; then
                break
            fi
            case "$act" in
                [sS])
                    stop_all_sessions
                    break
                    ;;
                [rR])
                    ;;
                [mM]|[bB]|''|[eE])
                    break
                    ;;
                [1-4])
                    c_idx=1
                    for s in SSH RECV FILES WEBGUI; do
                        if is_service_active "$s"; then
                            if [ "$c_idx" -eq "$act" ]; then
                                cur_svc="$s"
                                show_qr=0
                                break
                            fi
                            c_idx=$((c_idx + 1))
                        fi
                    done
                    ;;
                *)
                    break
                    ;;
            esac
        else
            render_single_session_card "$cur_svc" "$show_qr"
            if [ "$show_qr" = "1" ]; then
                qr_label="📱 Hide ${C_KEY}Q${C_RESET}R"
            else
                qr_label="📱 Show ${C_KEY}Q${C_RESET}R"
            fi
            if [ "$active_cnt" -gt 1 ]; then
                printf "  Actions: 🛑 %bS%btop This  |  📋 %bA%bll Sessions  |  🔄 %bR%befresh  |  %b  |  ↩️ %bM%bain Menu: " "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$qr_label" "$C_KEY" "$C_RESET"
            else
                printf "  Actions: 🛑 %bS%btop Session  |  🔄 %bR%befresh  |  %b  |  ↩️ %bM%bain Menu: " "$C_KEY" "$C_RESET" "$C_KEY" "$C_RESET" "$qr_label" "$C_KEY" "$C_RESET"
            fi

            if ! read -r act; then
                break
            fi
            case "$act" in
                [sS])
                    stop_single_session "$cur_svc"
                    if ! has_any_active_session; then
                        break
                    fi
                    cur_svc="ALL"
                    ;;
                [aA])
                    cur_svc="ALL"
                    show_qr=0
                    ;;
                [rR])
                    ;;
                [qQ])
                    if [ "$show_qr" = "1" ]; then
                        show_qr=0
                    else
                        show_qr=1
                    fi
                    ;;
                [mM]|[bB]|''|[eE])
                    break
                    ;;
                *)
                    break
                    ;;
            esac
        fi
    done
}

set_timeout_config() {
    t_err=""
    while true; do
        clear_screen
        draw_header
        printf "  %b⏱️ Configure Session Auto-Kill Timeout%b\n\n" "$C_CYAN" "$C_RESET"
        if [ "${TIMEOUT_MINUTES}" -eq 0 ]; then
            printf "  Current Timeout: %bDisabled (Persistent)%b\n\n" "$C_BOLD" "$C_RESET"
        else
            printf "  Current Timeout: %b%s minutes%b\n\n" "$C_BOLD" "${TIMEOUT_MINUTES}" "$C_RESET"
        fi

        if [ -n "$t_err" ]; then
            printf "  %b\n\n" "$t_err"
            t_err=""
        fi

        printf "  Enter timeout in minutes [0 for Persistent, default 30, e to cancel]: "
        if ! read -r user_t; then
            return
        fi
        case "$user_t" in
            [eE]|[bB]|cancel|exit)
                FLASH_MSG="${C_YELLOW}[*] Operation cancelled.${C_RESET}"
                return
                ;;
            [pP][eE][rR][sS][iI][sS][tT][eE][nN][tT]|[fF][oO][rR][eE][vV][eE][rR]|[uU][nN][lL][iI][mM][iI][tT][eE][dD])
                user_t=0
                ;;
            '')
                user_t=30
                ;;
            *[!0-9]*)
                t_err="${C_RED}[!] Invalid number. Please enter digits only (or 'e' to cancel).${C_RESET}"
                continue
                ;;
        esac

        if [ "$user_t" -lt 0 ]; then
            t_err="${C_RED}[!] Timeout cannot be negative.${C_RESET}"
            continue
        fi

        TIMEOUT_MINUTES="$user_t"
        mkdir -p "$CONFIG_DIR"
        echo "TIMEOUT_MINUTES=${TIMEOUT_MINUTES}" > "$CONFIG_FILE"
        if [ "$TIMEOUT_MINUTES" -eq 0 ]; then
            FLASH_MSG="${C_GREEN}[+] Auto-kill disabled (Sessions will run persistently until stopped).${C_RESET}"
        else
            FLASH_MSG="${C_GREEN}[+] Timeout updated to ${TIMEOUT_MINUTES} minutes.${C_RESET}"
        fi
        return
    done
}

update_binary() {
    clear_screen
    draw_header
    printf "  %b[*] Checking router architecture & downloading official TailCat engine binary...%b\n\n" "$C_CYAN" "$C_RESET"
    arch=$(uname -m)
    pkg_arch=""
    case "$arch" in
        armv7*|armv6*|arm) pkg_arch="armv7" ;;
        aarch64*|arm64*)  pkg_arch="arm64" ;;
        *)
            FLASH_MSG="${C_RED}[!] Unsupported router architecture: ${arch}${C_RESET}"
            return 1
            ;;
    esac

    mkdir -p "$BIN_DIR"
    download_url="https://github.com/tailscale/tailcat/releases/download/v0.4.0/tailcat_0.4.0_linux_${pkg_arch}.tar.gz"
    printf "  %b[*] Downloading %s...%b\n" "$C_CYAN" "${download_url}" "$C_RESET"

    if curl -fsSL "$download_url" | tar -xz -C "$BIN_DIR" tailcat; then
        chmod 755 "$TAILCAT_BIN"
        FLASH_MSG="${C_GREEN}[+] TailCat engine binary updated successfully (${pkg_arch}).${C_RESET}"
    else
        FLASH_MSG="${C_RED}[-] Failed to download TailCat engine binary.${C_RESET}"
        return 1
    fi
}

update_tailcat_all() {
    clear_screen
    draw_header
    printf "  %b[*] Checking for TAILCAT ZER0 script & engine updates...%b\n\n" "$C_CYAN" "$C_RESET"

    # 1. Update Bash Script from GitHub
    tmp_script="/tmp/tailcat.update"
    rm -f "$tmp_script"
    printf "  %b[*] Fetching latest TAILCAT ZER0 CLI script from GitHub...%b\n" "$C_CYAN" "$C_RESET"
    if curl -fsSL "https://raw.githubusercontent.com/underd0se/tailcat-zero/main/tailcat" -o "$tmp_script" 2>/dev/null; then
        chmod 755 "$tmp_script"
        mv -f "$tmp_script" /jffs/scripts/tailcat
        ln -sf /jffs/scripts/tailcat /jffs/scripts/tailcatzero 2>/dev/null || true
        rm -f /jffs/scripts/tailcatZero /jffs/scripts/tailcat-merlin 2>/dev/null || true
        if [ -d "/opt/bin" ]; then
            ln -sf /jffs/scripts/tailcat /opt/bin/tailcatzero 2>/dev/null || true
            rm -f /opt/bin/tailcat /opt/bin/tailcatZero /opt/bin/tailcat-merlin 2>/dev/null || true
        fi
        printf "  %b[+] TAILCAT ZER0 script updated successfully.%b\n\n" "$C_GREEN" "$C_RESET"
    else
        printf "  %b[!] Could not reach GitHub. Keeping current script.%b\n\n" "$C_YELLOW" "$C_RESET"
    fi

    # 2. Update Engine Binary
    update_binary || true
    FLASH_MSG="${C_GREEN}[+] TAILCAT ZER0 (script & engine) updated successfully.${C_RESET}"
}

reinstall_tailcat() {
    clear_screen
    draw_header
    printf "  %b⚡ Reinstalling TAILCAT ZER0...%b\n\n" "$C_CYAN" "$C_RESET"
    update_binary || true
    printf "  %b[*] Updating /jffs/scripts/tailcat...%b\n" "$C_CYAN" "$C_RESET"
    if curl -fsSL "https://raw.githubusercontent.com/underd0se/tailcat-zero/main/tailcat" -o /jffs/scripts/tailcat.tmp 2>/dev/null; then
