    printf "Usage:\n"
    printf "  %btailcatzero%b                           Launch interactive TUI dashboard (default)\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero status%b                    Display running sessions and connect tokens\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero stop [all|SVC]%b            Stop all sessions or a specific service (SSH, VIEW, RECV, FILES, WEBGUI)\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero ssh [root|view]%b           Start remote shell tunnel (default root)\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero view%b                      Start restricted view-only diagnostic shell\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero recv [dir]%b                Start encrypted DropBox tunnel (default /tmp/tailcat-inbox)\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero files [dir] [ro|rw]%b       Start SFTP directory share (default /jffs ro)\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero webgui%b                    Start router WebGUI tunnel\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero requests%b                  List pending guest permission requests\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero approve [id|cmd] [--once]%b Approve guest request (session-wide or single-use)\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero deny [id|cmd]%b             Deny guest request and suppress repeat prompts\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero allow <cmd>%b               Proactively permit command in view-only mode\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero revoke <cmd>%b              Revoke command permission from view-only mode\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero timeout [min|persistent]%b  Get or configure default auto-kill session timeout\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero update%b                    Update TAILCAT ZER0 script & engine\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero -v, --version%b             Show version\n" "$C_CYAN" "$C_RESET"
    printf "  %btailcatzero -h, --help%b                Show this help message\n\n" "$C_CYAN" "$C_RESET"
}

cli_status() {
    cnt=$(get_active_service_count)
    if [ "$cnt" -eq 0 ]; then
        printf "%b[⚪] No active TAILCAT ZER0 sessions running.%b\n" "$C_GRAY" "$C_RESET"
        return 0
    fi
    printf "%b[🟢] Active TAILCAT ZER0 Sessions (%d Running):%b\n\n" "$C_GREEN" "$cnt" "$C_RESET"
    for s in SSH VIEW RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            s_file="${SESSIONS_DIR}/${s}.env"
            # shellcheck disable=SC1090
            . "$s_file"
            tl=$(get_service_time_left "$s")
            cmd=$(get_client_connect_cmd "$s" "$TOKEN")
            printf "  • %b%-26s%b ⏱️  %-14s PID: %s\n" "$C_BOLD" "${DESC}" "$C_RESET" "$tl" "${PID:-unknown}"
            if [ "$s" = "WEBGUI" ]; then
                read -r wp_proto wp_port <<EOF
$(get_webgui_connect_info "${EXTRA_INFO:-}")
EOF
                printf "    Connect: %b%s%b (Open %s://localhost:%s)\n" "$C_YELLOW" "$cmd" "$C_RESET" "${wp_proto}" "${wp_port}"
            else
                printf "    Connect: %b%s%b\n" "$C_YELLOW" "$cmd" "$C_RESET"
            fi
            if [ "$s" = "VIEW" ]; then
                p_cnt=$(get_pending_request_count)
                if [ "$p_cnt" -gt 0 ]; then
                    printf "    Requests: %b🔔 %d Pending ('tailcatzero requests' or 'tailcatzero approve')%b\n" "$C_YELLOW" "$p_cnt" "$C_RESET"
                fi
                if [ -s "$VIEW_APPROVED_FILE" ]; then
                    app_str=$(tr '\n' ' ' < "$VIEW_APPROVED_FILE" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                    [ -n "$app_str" ] && printf "    Allowed:  %b%s%b\n" "$C_GREEN" "$app_str" "$C_RESET"
                fi
            fi
            printf "\n"
        fi
    done
}

if [ $# -gt 0 ]; then
    case "${1:-}" in
        status|list)
            cli_status
            exit 0
            ;;
        requests|req|reqs)
            cli_requests
            exit 0
            ;;
        approve)
            shift
            cli_approve "$@"
            exit $?
            ;;
        deny)
            shift
            cli_deny "$@"
            exit $?
            ;;
        allow)
            if [ -z "${2:-}" ]; then
                printf "%bUsage: tailcatzero allow <command>%b\n" "$C_CYAN" "$C_RESET"
                exit 1
            fi
            allow_command_session "$2"
            exit $?
            ;;
        revoke)
            if [ -z "${2:-}" ]; then
                printf "%bUsage: tailcatzero revoke <command>%b\n" "$C_CYAN" "$C_RESET"
                exit 1
            fi
            revoke_command_session "$2"
            exit $?
            ;;
        stop)
            target="${2:-all}"
            case "$target" in
                all|[aA])
                    stop_all_sessions
                    ;;
                SSH|ssh|root|1)
                    stop_single_session "SSH"
                    ;;
                VIEW|view|ro|5)
                    stop_single_session "VIEW"
                    ;;
                RECV|recv|2)
                    stop_single_session "RECV"
                    ;;
                FILES|files|sftp|3)
                    stop_single_session "FILES"
                    ;;
                WEBGUI|webgui|web|4)
                    stop_single_session "WEBGUI"
                    ;;
                *)
                    printf "%b[!] Unknown service: %s%b\n" "$C_RED" "$target" "$C_RESET"
                    exit 1
                    ;;
            esac
            exit 0
            ;;
        ssh)
            mode="${2:-root}"
            case "$mode" in
                view|ro|readonly|read-only)
                    start_tunnel "VIEW" "serve no-auth-ssh" "🔒 View-Only Diagnostic Shell" "" 0
                    ;;
                root|rw|admin|*)
                    start_tunnel "SSH" "serve no-auth-ssh" "🆘 Remote Support Shell (Root)" "" 0
                    ;;
            esac
            exit 0
            ;;
        view|ro)
            start_tunnel "VIEW" "serve no-auth-ssh" "🔒 View-Only Diagnostic Shell" "" 0
            exit 0
            ;;
        recv)
            target_dir="${2:-/tmp/tailcat-inbox}"
            mkdir -p "$target_dir"
            start_tunnel "RECV" "recv ${target_dir}" "📥 Encrypted File DropBox" "${target_dir}" 0
            exit 0
            ;;
        files|sftp)
            target_dir="${2:-/jffs}"
            perm="${3:-ro}"
            case "$perm" in
                rw|write|2) perm="rw" ;;
                *) perm="ro" ;;
            esac
            if [ ! -d "$target_dir" ]; then
                printf "%b[!] Directory %s does not exist.%b\n" "$C_RED" "$target_dir" "$C_RESET"
                exit 1
            fi
            start_tunnel "FILES" "serve --files=${target_dir}:${perm} files" "📁 SFTP File Share (${target_dir})" "Path: ${target_dir} (${perm})" 0
            exit 0
            ;;
        webgui|web)
            start_webgui_tunnel 0
            exit 0
            ;;
        timeout)
            if [ -z "${2:-}" ]; then
                if [ "${TIMEOUT_MINUTES}" -eq 0 ]; then
                    printf "Default Timeout: %bDisabled (Persistent)%b\n" "$C_BOLD" "$C_RESET"
                else
                    printf "Default Timeout: %b%s minutes%b\n" "$C_BOLD" "${TIMEOUT_MINUTES}" "$C_RESET"
                fi
                exit 0
            fi
            val="$2"
            case "$val" in
                [pP][eE][rR][sS][iI][sS][tT][eE][nN][tT]|[fF][oO][rR][eE][vV][eE][rR]|[uU][nN][lL][iI][mM][iI][tT][eE][dD]|0)
                    save_timeout_config 0
                    printf "%b[+] Default session timeout set to Persistent (auto-kill disabled).%b\n" "$C_GREEN" "$C_RESET"
                    ;;
                *[!0-9]*)
                    printf "%b[!] Invalid timeout: %s. Must be digits (minutes) or 'persistent'.%b\n" "$C_RED" "$val" "$C_RESET"
                    exit 1
                    ;;
                *)
                    save_timeout_config "$val"
                    printf "%b[+] Default session timeout set to %s minutes.%b\n" "$C_GREEN" "$val" "$C_RESET"
                    ;;
            esac
            exit 0
            ;;
        update)
            update_tailcat_all
            exit 0
            ;;
        -v|--version|version)
            printf "TAILCAT ZER0 v%s (engine %s)\n" "$VERSION" "$(get_binary_version)"
            exit 0
            ;;
        -h|--help|help)
            cli_help
            exit 0
            ;;
        *)
            printf "%b[!] Unknown argument: %s%b\n\n" "$C_RED" "$1" "$C_RESET"
            cli_help
            exit 1
            ;;
    esac
fi

