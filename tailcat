#!/bin/sh
# =========================================================================================================================
# TAILCAT ZER0 — Ephemeral WireGuard Tunnel & Multi-Service Manager for Asuswrt-Merlin
# =========================================================================================================================
# shellcheck disable=SC2153

set -eu

VERSION="1.7.0"
CONFIG_DIR="/jffs/addons/tailcat"
CONFIG_FILE="${CONFIG_DIR}/tailcat.cfg"
BIN_DIR="${CONFIG_DIR}/bin"
TAILCAT_BIN="${BIN_DIR}/tailcat"
VIEW_SHELL="${BIN_DIR}/tailcat-view-shell"
SESSIONS_DIR="/tmp/tailcat_sessions"
REQUESTS_DIR="${SESSIONS_DIR}/requests"
VIEW_APPROVED_FILE="${SESSIONS_DIR}/VIEW_APPROVED.txt"
VIEW_DENIED_FILE="${SESSIONS_DIR}/VIEW_DENIED.txt"
VIEW_ONCE_DIR="${SESSIONS_DIR}/VIEW_ONCE"
LOG_TAG="tailcatzero"

# ANSI Color Palette
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_KEY="\033[1;4m" # Bold + Underline for hotkeys
C_GREEN="\033[1;32m"
C_CYAN="\033[1;36m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_GRAY="\033[0;37m" # Readable muted white/gray
C_WHITE="\033[1;37m" # Crisp high-contrast white
C_MAGENTA="\033[1;35m"

trap 'printf "%b" "$C_RESET" 2>/dev/null || true' EXIT INT TERM

# Default Configuration
DEFAULT_TIMEOUT=30 # 30 minutes
DERP_URL="https://tailcat.dev/derpmap.json"
export DERP_URL

# Load Config if exists
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi

TIMEOUT_MINUTES="${TIMEOUT_MINUTES:-$DEFAULT_TIMEOUT}"
mkdir -p "$SESSIONS_DIR"
FLASH_MSG=""

# -------------------------------------------------------------------------------------------------------------------------
# Helper Functions

clear_screen() {
    if [ -t 1 ]; then
        printf "\033[2J\033[H"
    fi
}

log_msg() {
    logger -t "$LOG_TAG" "$*"
}

is_service_active() {
    s_id="$1"
    s_file="${SESSIONS_DIR}/${s_id}.env"
    if [ -f "$s_file" ]; then
        # shellcheck disable=SC1090
        . "$s_file"
        if [ -n "${PID:-}" ] && kill -0 "$PID" 2>/dev/null; then
            return 0
        fi
        if [ -n "${WATCHDOG_PID:-}" ]; then
            kill -9 "$WATCHDOG_PID" 2>/dev/null || true
        fi
        rm -f "$s_file" "/tmp/tailcat_addr_${s_id}.txt" 2>/dev/null || true
    fi
    return 1
}

has_any_active_session() {
    for s in SSH VIEW RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            return 0
        fi
    done
    return 1
}

get_active_service_count() {
    cnt=0
    for s in SSH VIEW RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            cnt=$((cnt + 1))
        fi
    done
    echo "$cnt"
}

get_free_space() {
    target_path="$1"
    if [ -d "$target_path" ]; then
        df -h "$target_path" 2>/dev/null | awk 'NR==2 {print $4}' || echo "N/A"
    else
        echo "N/A"
    fi
}

get_service_time_left() {
    s_id="$1"
    s_file="${SESSIONS_DIR}/${s_id}.env"
    if is_service_active "$s_id"; then
        # shellcheck disable=SC1090
        . "$s_file"
        if [ "${EXPIRE_EPOCH:-0}" -eq 0 ]; then
            printf "Persistent"
            return
        fi
        now=$(date +%s)
        if [ "$now" -lt "${EXPIRE_EPOCH:-0}" ]; then
            diff=$(( EXPIRE_EPOCH - now ))
            if [ "$diff" -lt 60 ]; then
                printf "< 1m remaining"
                return
            fi
            remaining=$(( diff / 60 ))
            printf "%sm remaining" "$remaining"
            return
        fi
    fi
    printf "Expired"
}

get_service_badge() {
    s_id="$1"
    if is_service_active "$s_id"; then
        tl=$(get_service_time_left "$s_id")
        printf "%b[🟢 Active: %s]%b" "$C_GREEN" "$tl" "$C_RESET"
    else
        printf "%b[⚪ Inactive]%b" "$C_GRAY" "$C_RESET"
    fi
}

get_shell_service_badge() {
    ssh_act=0
    view_act=0
    is_service_active "SSH" && ssh_act=1
    is_service_active "VIEW" && view_act=1

    if [ "$ssh_act" = "1" ] && [ "$view_act" = "1" ]; then
        printf "%b[🟢 Root + 🔒 View]%b" "$C_GREEN" "$C_RESET"
    elif [ "$ssh_act" = "1" ]; then
        tl=$(get_service_time_left "SSH")
        printf "%b[🟢 Root: %s]%b" "$C_GREEN" "$tl" "$C_RESET"
    elif [ "$view_act" = "1" ]; then
        tl=$(get_service_time_left "VIEW")
        printf "%b[🔒 View-Only: %s]%b" "$C_YELLOW" "$tl" "$C_RESET"
    else
        printf "%b[⚪ Inactive]%b" "$C_GRAY" "$C_RESET"
    fi
}

stop_single_session() {
    s_id="$1"
    s_file="${SESSIONS_DIR}/${s_id}.env"
    addr_file="/tmp/tailcat_addr_${s_id}.txt"
    if [ -f "$s_file" ]; then
        # shellcheck disable=SC1090
        . "$s_file"
        if [ -n "${PID:-}" ]; then
            kill -9 "$PID" 2>/dev/null || true
            wait "$PID" 2>/dev/null || true
        fi
        if [ -n "${WATCHDOG_PID:-}" ]; then
            kill -9 "$WATCHDOG_PID" 2>/dev/null || true
            wait "$WATCHDOG_PID" 2>/dev/null || true
        fi
        rm -f "$s_file" "$addr_file"
        if [ "$s_id" = "VIEW" ]; then
            rm -rf "${REQUESTS_DIR:?}"/* "${VIEW_ONCE_DIR:?}"/* 2>/dev/null || true
            rm -f "$VIEW_APPROVED_FILE" "$VIEW_DENIED_FILE" 2>/dev/null || true
        fi
        log_msg "TailCat session stopped: ${s_id}"
        printf "\n%b[+] Stopped session: %s%b\n" "$C_GREEN" "${DESC:-$s_id}" "$C_RESET"
    else
        rm -f "$s_file" "$addr_file"
        if [ "$s_id" = "VIEW" ]; then
            rm -rf "${REQUESTS_DIR:?}"/* "${VIEW_ONCE_DIR:?}"/* 2>/dev/null || true
            rm -f "$VIEW_APPROVED_FILE" "$VIEW_DENIED_FILE" 2>/dev/null || true
        fi
    fi
}

stop_all_sessions() {
    found=0
    for s in SSH VIEW RECV FILES WEBGUI; do
        if [ -f "${SESSIONS_DIR}/${s}.env" ]; then
            stop_single_session "$s"
            found=1
        fi
    done
    if [ "$found" = "0" ]; then
        printf "\n%b[!] No active TailCat sessions found.%b\n" "$C_YELLOW" "$C_RESET"
    fi
}

stop_sessions_with_confirmation() {
    count=$(get_active_service_count)
    if [ "$count" -eq 0 ]; then
        FLASH_MSG="${C_YELLOW}[!] No active TailCat sessions are currently running.${C_RESET}"
        return
    fi

    clear_screen
    draw_header
    printf "  %b%b🛑 Running TailCat Processes (%d Active):%b\n\n" "$C_CYAN" "$C_BOLD" "$count" "$C_RESET"

    svc_1=""
    svc_2=""
    svc_3=""
    svc_4=""
    svc_5=""
    idx=1
    for s in SSH VIEW RECV FILES WEBGUI; do
        if is_service_active "$s"; then
            eval "svc_${idx}=\"\$s\""
            s_file="${SESSIONS_DIR}/${s}.env"
            # shellcheck disable=SC1090
            . "$s_file"
            tl=$(get_service_time_left "$s")
            printf "  %b%d.%b %b%-30s%b %b(PID: %s, %s)%b\n" "$C_BOLD" "$idx" "$C_RESET" "$C_CYAN" "${DESC}" "$C_RESET" "$C_GRAY" "${PID:-unknown}" "$tl" "$C_RESET"
            idx=$((idx + 1))
        fi
    done

    printf "\n%b%b========================================================================%b\n\n" "$C_CYAN" "$C_BOLD" "$C_RESET"

    if [ "$count" -gt 1 ]; then
        printf "   Choice [1-%d=Stop individual, a=Stop All, e to cancel]: " "$count"
    else
        printf "   Stop this session? [1/y=Stop, e to cancel]: "
    fi

    if ! read -r confirm_stop; then
        FLASH_MSG="${C_YELLOW}[*] Operation cancelled.${C_RESET}"
        return
    fi

    case "$confirm_stop" in
        [aA]|[aA][lL][lL]|[yY]|[yY][eE][sS])
            stop_all_sessions
            FLASH_MSG="${C_GREEN}[+] All active TailCat sessions stopped.${C_RESET}"
            ;;
        1|2|3|4|5)
            target_svc=""
            case "$confirm_stop" in
                1) target_svc="$svc_1" ;;
                2) target_svc="$svc_2" ;;
                3) target_svc="$svc_3" ;;
                4) target_svc="$svc_4" ;;
                5) target_svc="$svc_5" ;;
            esac
            if [ -n "$target_svc" ]; then
                s_file="${SESSIONS_DIR}/${target_svc}.env"
                svc_desc="$target_svc"
                if [ -f "$s_file" ]; then
                    # shellcheck disable=SC1090
                    . "$s_file"
                    svc_desc="${DESC:-$target_svc}"
                fi
                stop_single_session "$target_svc"
                FLASH_MSG="${C_GREEN}[+] Stopped ${svc_desc}.${C_RESET}"
            else
                FLASH_MSG="${C_RED}[!] Invalid selection.${C_RESET}"
            fi
            ;;
        [eE]|[bB]|cancel|exit|'')
            FLASH_MSG="${C_YELLOW}[*] Operation cancelled.${C_RESET}"
            ;;
        *)
            FLASH_MSG="${C_RED}[!] Invalid selection.${C_RESET}"
            ;;
    esac
}

# -------------------------------------------------------------------------------------------------------------------------
# On-Demand Permission Escalation for View-Only Sessions

get_pending_request_count() {
    if [ ! -d "$REQUESTS_DIR" ]; then
        echo "0"
        return
    fi
    now=$(date +%s)
    count=0
    for f in "${REQUESTS_DIR}"/*.req; do
        if [ -f "$f" ]; then
            c_time=0
            if [ -s "$f" ]; then
                c_time=$(grep '^CREATED_AT=' "$f" 2>/dev/null | cut -d'"' -f2 || echo 0)
            fi
            if [ "$c_time" -gt 0 ] && [ $((now - c_time)) -gt 120 ]; then
                rm -f "$f" 2>/dev/null || true
                continue
            fi
            count=$((count + 1))
        fi
    done
    echo "$count"
}

resolve_single_request() {
    target_req_file="$1"
    status="$2"

    [ -f "$target_req_file" ] || return 1

    # shellcheck disable=SC1090
    . "$target_req_file"

    mkdir -p "$SESSIONS_DIR" "$REQUESTS_DIR" "$VIEW_ONCE_DIR"
    resp_f="${REQUESTS_DIR}/${REQ_ID}.resp"

    # Red line safeguard check: permanent block on hardware/flash bricking
    case "${RAW_COMMAND:-}" in
        *"/dev/mtd"*|*"rm -rf /"*|*"nvram erase"*)
            status="DENIED"
            ;;
    esac

    case "$status" in
        APPROVED_SESSION)
            if [ -f "$VIEW_APPROVED_FILE" ]; then
                grep -Fxv "$BASE_CMD" "$VIEW_APPROVED_FILE" > "${VIEW_APPROVED_FILE}.tmp" 2>/dev/null || true
                mv -f "${VIEW_APPROVED_FILE}.tmp" "$VIEW_APPROVED_FILE" 2>/dev/null || true
            fi
            echo "$BASE_CMD" >> "$VIEW_APPROVED_FILE"
            if [ -f "$VIEW_DENIED_FILE" ]; then
                grep -Fxv "$BASE_CMD" "$VIEW_DENIED_FILE" > "${VIEW_DENIED_FILE}.tmp" 2>/dev/null || true
                mv -f "${VIEW_DENIED_FILE}.tmp" "$VIEW_DENIED_FILE" 2>/dev/null || true
            fi
            log_msg "Admin APPROVED session permission for: ${BASE_CMD} (${REQ_ID})"
            ;;
        APPROVED_ONCE)
            touch "${VIEW_ONCE_DIR}/${BASE_CMD}.token"
            log_msg "Admin APPROVED once permission for: ${BASE_CMD} (${REQ_ID})"
            ;;
        DENIED)
            if [ -f "$VIEW_DENIED_FILE" ]; then
                grep -Fxv "$BASE_CMD" "$VIEW_DENIED_FILE" > "${VIEW_DENIED_FILE}.tmp" 2>/dev/null || true
                mv -f "${VIEW_DENIED_FILE}.tmp" "$VIEW_DENIED_FILE" 2>/dev/null || true
            fi
            echo "$BASE_CMD" >> "$VIEW_DENIED_FILE"
            log_msg "Admin DENIED permission for: ${BASE_CMD} (${REQ_ID})"
            ;;
    esac

    {
        echo "REQ_ID=\"${REQ_ID}\""
        echo "STATUS=\"${status}\""
        echo "RESOLVED_AT=\"$(date +%s)\""
    } > "$resp_f"

    rm -f "$target_req_file" 2>/dev/null || true
}

allow_command_session() {
    target_cmd="$1"
    b_cmd=$(basename "$target_cmd" | awk '{print $1}')

    case "$b_cmd" in
        *"/dev/mtd"*|*"rm -rf /"*|*"nvram erase"*)
            printf "%b[!] Security Error: Destructive hardware / partition operations cannot be approved.%b\n" "$C_RED" "$C_RESET"
            return 1
            ;;
    esac

    mkdir -p "$SESSIONS_DIR"
    if [ -f "$VIEW_APPROVED_FILE" ]; then
        grep -Fxv "$b_cmd" "$VIEW_APPROVED_FILE" > "${VIEW_APPROVED_FILE}.tmp" 2>/dev/null || true
        mv -f "${VIEW_APPROVED_FILE}.tmp" "$VIEW_APPROVED_FILE" 2>/dev/null || true
    fi
    echo "$b_cmd" >> "$VIEW_APPROVED_FILE"
    if [ -f "$VIEW_DENIED_FILE" ]; then
        grep -Fxv "$b_cmd" "$VIEW_DENIED_FILE" > "${VIEW_DENIED_FILE}.tmp" 2>/dev/null || true
        mv -f "${VIEW_DENIED_FILE}.tmp" "$VIEW_DENIED_FILE" 2>/dev/null || true
    fi

    if [ -d "$REQUESTS_DIR" ]; then
        for f in "${REQUESTS_DIR}"/*.req; do
            [ -f "$f" ] || continue
            # shellcheck disable=SC1090
            . "$f"
            if [ "${BASE_CMD:-}" = "$b_cmd" ]; then
                resolve_single_request "$f" "APPROVED_SESSION"
            fi
        done
    fi

    printf "%b[+] Permitted '%s' for active view-only session.%b\n" "$C_GREEN" "$b_cmd" "$C_RESET"
    log_msg "Admin allowed command: ${b_cmd}"
    return 0
}

revoke_command_session() {
    target_cmd="$1"
    b_cmd=$(basename "$target_cmd" | awk '{print $1}')

    if [ -f "$VIEW_APPROVED_FILE" ]; then
        grep -Fxv "$b_cmd" "$VIEW_APPROVED_FILE" > "${VIEW_APPROVED_FILE}.tmp" 2>/dev/null || true
        mv -f "${VIEW_APPROVED_FILE}.tmp" "$VIEW_APPROVED_FILE" 2>/dev/null || true
        printf "%b[+] Revoked '%s' from approved view session commands.%b\n" "$C_GREEN" "$b_cmd" "$C_RESET"
        log_msg "Admin revoked command: ${b_cmd}"
    else
        printf "%b[!] No approved commands found for view session.%b\n" "$C_YELLOW" "$C_RESET"
    fi
}

show_approval_modal() {
    clear_screen
    draw_header
    printf "  %b🔔 Pending Guest Permission Requests:%b\n\n" "$C_CYAN" "$C_RESET"

    req_cnt=$(get_pending_request_count)
    if [ "$req_cnt" -eq 0 ]; then
        printf "  %bNo pending permission requests at this time.%b\n\n" "$C_GRAY" "$C_RESET"
        printf "  Press Enter to return: "
        # shellcheck disable=SC2034
        read -r dummy || true
        return
    fi

    now=$(date +%s)
    idx=1
    for f in "${REQUESTS_DIR}"/*.req; do
        [ -f "$f" ] || continue
        # shellcheck disable=SC1090
        . "$f"
        age=$((now - CREATED_AT))
        printf "  %b[%d]%b Tool: %b%-14s%b Age: %ds\n" "$C_BOLD" "$idx" "$C_RESET" "$C_YELLOW" "${BASE_CMD}" "$C_RESET" "$age"
        printf "      Full Command: %b%s%b\n" "$C_WHITE" "${RAW_COMMAND}" "$C_RESET"
        printf "      Request ID:   %s\n\n" "${REQ_ID}"
        eval "req_file_${idx}=\"$f\""
        idx=$((idx + 1))
    done
    total_req=$((idx - 1))

    sel_req=1
    if [ "$total_req" -gt 1 ]; then
        printf "  Select request to resolve [1-%d, or e to return]: " "$total_req"
        if ! read -r r_pick; then
            return
        fi
        case "$r_pick" in
            [eE]|[bB]|cancel|exit) return ;;
            [1-9]*)
                if [ "$r_pick" -ge 1 ] && [ "$r_pick" -le "$total_req" ]; then
                    sel_req="$r_pick"
                else
                    FLASH_MSG="${C_RED}[!] Invalid request selection.${C_RESET}"
                    return
                fi
                ;;
            *)
                FLASH_MSG="${C_RED}[!] Invalid request selection.${C_RESET}"
                return
                ;;
        esac
    fi

    chosen_f=""
    eval "chosen_f=\"\$req_file_${sel_req}\""
    if [ ! -f "$chosen_f" ]; then
        FLASH_MSG="${C_RED}[!] Request is no longer active.${C_RESET}"
        return
    fi

    # shellcheck disable=SC1090
    . "$chosen_f"

    printf "%b------------------------------------------------------------------------%b\n" "$C_CYAN" "$C_RESET"
    printf "  Resolving Request for: %b%s%b\n" "$C_YELLOW" "${BASE_CMD}" "$C_RESET"
    printf "  Command: %b%s%b\n\n" "$C_WHITE" "${RAW_COMMAND}" "$C_RESET"
    printf "  1. ⚡ %bApprove for this session%b (Full allowance for remainder of session)\n" "$C_GREEN" "$C_RESET"
    printf "  2. ⏱️ %bApprove once%b             (Single execution only)\n" "$C_CYAN" "$C_RESET"
    printf "  3. ❌ %bDeny request%b             (Block execution & suppress repeat prompts)\n" "$C_RED" "$C_RESET"
    printf "  4. ↩️ %bIgnore / Dismiss%b\n\n" "$C_GRAY" "$C_RESET"
    printf "  Choice [1-4, Default 1]: "

    if ! read -r a_pick; then
        return
    fi

    case "$a_pick" in
        1|'')
            resolve_single_request "$chosen_f" "APPROVED_SESSION"
            FLASH_MSG="${C_GREEN}[+] Approved '${BASE_CMD}' for this session.${C_RESET}"
            ;;
        2)
            resolve_single_request "$chosen_f" "APPROVED_ONCE"
            FLASH_MSG="${C_GREEN}[+] Approved single execution of '${BASE_CMD}'.${C_RESET}"
            ;;
        3)
            resolve_single_request "$chosen_f" "DENIED"
            FLASH_MSG="${C_RED}[-] Denied request for '${BASE_CMD}'.${C_RESET}"
            ;;
        4|[eE]|[bB]|cancel|exit)
            FLASH_MSG="${C_YELLOW}[*] Request left pending.${C_RESET}"
            ;;
        *)
            FLASH_MSG="${C_RED}[!] Invalid selection.${C_RESET}"
            ;;
    esac
}

cli_requests() {
    cnt=$(get_pending_request_count)
    if [ "$cnt" -eq 0 ]; then
        printf "%b[⚪] No pending guest permission requests.%b\n" "$C_GRAY" "$C_RESET"
        if [ -s "$VIEW_APPROVED_FILE" ]; then
            printf "Approved for session: %b%s%b\n" "$C_GREEN" "$(tr '\n' ' ' < "$VIEW_APPROVED_FILE")" "$C_RESET"
        fi
        return 0
    fi
    printf "%b[🔔] Pending Guest Permission Requests (%d Pending):%b\n\n" "$C_YELLOW" "$cnt" "$C_RESET"
    now=$(date +%s)
    idx=1
    for f in "${REQUESTS_DIR}"/*.req; do
        [ -f "$f" ] || continue
        # shellcheck disable=SC1090
        . "$f"
        age=$((now - CREATED_AT))
        printf "  • %b[%d] ID: %s%b (Age: %ds)\n" "$C_BOLD" "$idx" "${REQ_ID}" "$C_RESET" "$age"
        printf "    Tool:    %b%s%b\n" "$C_YELLOW" "${BASE_CMD}" "$C_RESET"
        printf "    Command: %s\n\n" "${RAW_COMMAND}"
        idx=$((idx + 1))
    done
    printf "Run: %btailcatzero approve [ID|tool]%b or %btailcatzero deny [ID|tool]%b\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
}

cli_approve() {
    mode="APPROVED_SESSION"
    target=""
    for arg in "$@"; do
        case "$arg" in
            --once|-1|once)
                mode="APPROVED_ONCE"
                ;;
            *)
                if [ -z "$target" ]; then
                    target="$arg"
                fi
                ;;
        esac
    done

    if [ -z "$target" ]; then
        cnt=$(get_pending_request_count)
        if [ "$cnt" -eq 0 ]; then
            printf "%b[!] No pending requests to approve. Usage: tailcatzero approve [ID|command]%b\n" "$C_RED" "$C_RESET"
            return 1
        elif [ "$cnt" -eq 1 ]; then
            target_file=""
            for f in "${REQUESTS_DIR}"/*.req; do
                [ -f "$f" ] && target_file="$f" && break
            done
            if [ -n "$target_file" ]; then
                # shellcheck disable=SC1090
                . "$target_file"
                resolve_single_request "$target_file" "$mode"
                if [ "$mode" = "APPROVED_ONCE" ]; then
                    printf "%b[+] Approved single execution for request '%s'.%b\n" "$C_GREEN" "${REQ_ID:-unknown}" "$C_RESET"
                else
                    printf "%b[+] Approved '%s' for active view-only session.%b\n" "$C_GREEN" "${BASE_CMD:-unknown}" "$C_RESET"
                fi
                return 0
            fi
        else
            printf "%b[!] Multiple pending requests exist. Please specify ID or tool name:%b\n" "$C_YELLOW" "$C_RESET"
            cli_requests
            return 1
        fi
    fi

    found_req=""
    if [ -d "$REQUESTS_DIR" ]; then
        for f in "${REQUESTS_DIR}"/*.req; do
            [ -f "$f" ] || continue
            # shellcheck disable=SC1090
            . "$f"
            if [ "${REQ_ID:-}" = "$target" ] || [ "${BASE_CMD:-}" = "$target" ]; then
                found_req="$f"
                break
            fi
        done
    fi

    if [ -n "$found_req" ]; then
        # shellcheck disable=SC1090
        . "$found_req"
        resolve_single_request "$found_req" "$mode"
        if [ "$mode" = "APPROVED_ONCE" ]; then
            printf "%b[+] Approved single execution for '%s'.%b\n" "$C_GREEN" "$target" "$C_RESET"
        else
            printf "%b[+] Approved '%s' for active view-only session.%b\n" "$C_GREEN" "$target" "$C_RESET"
        fi
        return 0
    fi

    if [ "$mode" = "APPROVED_SESSION" ]; then
        allow_command_session "$target"
        return $?
    else
        printf "%b[!] No pending request found for '%s' to approve once.%b\n" "$C_RED" "$target" "$C_RESET"
        return 1
    fi
}

cli_deny() {
    target="${1:-}"
    if [ -z "$target" ]; then
        cnt=$(get_pending_request_count)
        if [ "$cnt" -eq 0 ]; then
            printf "%b[!] No pending requests to deny. Usage: tailcatzero deny [ID|command]%b\n" "$C_RED" "$C_RESET"
            return 1
        elif [ "$cnt" -eq 1 ]; then
            target_file=""
            for f in "${REQUESTS_DIR}"/*.req; do
                [ -f "$f" ] && target_file="$f" && break
            done
            if [ -n "$target_file" ]; then
                # shellcheck disable=SC1090
                . "$target_file"
                resolve_single_request "$target_file" "DENIED"
                printf "%b[-] Denied pending request '%s'.%b\n" "$C_RED" "${BASE_CMD:-unknown}" "$C_RESET"
                return 0
            fi
        else
            printf "%b[!] Multiple pending requests exist. Please specify ID or tool name:%b\n" "$C_YELLOW" "$C_RESET"
            cli_requests
            return 1
        fi
    fi

    found_req=""
    if [ -d "$REQUESTS_DIR" ]; then
        for f in "${REQUESTS_DIR}"/*.req; do
            [ -f "$f" ] || continue
            # shellcheck disable=SC1090
            . "$f"
            if [ "${REQ_ID:-}" = "$target" ] || [ "${BASE_CMD:-}" = "$target" ]; then
                found_req="$f"
                break
            fi
        done
    fi

    if [ -n "$found_req" ]; then
        resolve_single_request "$found_req" "DENIED"
        printf "%b[-] Denied request for '%s'.%b\n" "$C_RED" "$target" "$C_RESET"
        return 0
    fi

    mkdir -p "$SESSIONS_DIR"
    if [ -f "$VIEW_DENIED_FILE" ]; then
        grep -Fxv "$target" "$VIEW_DENIED_FILE" > "${VIEW_DENIED_FILE}.tmp" 2>/dev/null || true
        mv -f "${VIEW_DENIED_FILE}.tmp" "$VIEW_DENIED_FILE" 2>/dev/null || true
    fi
    echo "$target" >> "$VIEW_DENIED_FILE"
    printf "%b[-] Added '%s' to denied list for view-only session.%b\n" "$C_RED" "$target" "$C_RESET"
    return 0
}

get_qrencode_cmd() {
    if command -v qrencode >/dev/null 2>&1; then
        echo "qrencode"
    elif [ -x "/usr/sbin/qrencode" ]; then
        echo "/usr/sbin/qrencode"
    elif [ -x "/opt/bin/qrencode" ]; then
        echo "/opt/bin/qrencode"
    else
        echo ""
    fi
}

ensure_dependencies() {
    # 1. Engine binary
    if [ ! -x "$TAILCAT_BIN" ]; then
        update_binary || true
    fi

    # 2. QR code engine (auto-install if opkg available)
    qr_bin=$(get_qrencode_cmd)
    if [ -z "$qr_bin" ] && [ -x "/opt/bin/opkg" ]; then
        /opt/bin/opkg update >/dev/null 2>&1 || true
        /opt/bin/opkg install qrencode >/dev/null 2>&1 || true
    fi

    # 3. View-Only Shell script
    if [ ! -x "$VIEW_SHELL" ]; then
        mkdir -p "$BIN_DIR"
        if [ -f "./tailcat-view-shell" ]; then
            cp -f "./tailcat-view-shell" "$VIEW_SHELL"
        else
            curl -fsSL "https://raw.githubusercontent.com/underd0se/tailcat-zero/main/tailcat-view-shell" -o "$VIEW_SHELL" 2>/dev/null || true
        fi
        chmod 755 "$VIEW_SHELL" 2>/dev/null || true
    fi
}

get_binary_version() {
    if [ -x "$TAILCAT_BIN" ]; then
        b_ver=$("$TAILCAT_BIN" --version 2>/dev/null | head -n 1 | tr -d '\r\n' || true)
        if [ -n "$b_ver" ]; then
            printf "%s" "$b_ver"
            return
        fi
    fi
    printf "v%s" "$VERSION"
}

