    draw_header
    printf "  %b🗑️  Uninstall TAILCAT ZER0%b\n\n" "$C_RED" "$C_RESET"
    printf "  This will terminate all active sessions and clean up all TailCat files.\n\n"
    printf "   Are you sure you want to completely remove TAILCAT ZER0? [y/N]: "
    if ! read -r confirm_un; then
        FLASH_MSG="${C_YELLOW}[*] Uninstall cancelled.${C_RESET}"
        return
    fi
    case "$confirm_un" in
        [yY]*)
            stop_all_sessions
            if [ -f "/jffs/scripts/init-start" ]; then
                sed -i '/[tT][aA][iI][lL][cC][aA][tT]/d' /jffs/scripts/init-start 2>/dev/null || true
            fi
            rm -rf "$CONFIG_DIR" "$SESSIONS_DIR" /jffs/scripts/tailcat /jffs/scripts/tailcatZero /jffs/scripts/tailcatzero /jffs/scripts/tailcat-merlin /opt/bin/tailcat /opt/bin/tailcatZero /opt/bin/tailcatzero /opt/bin/tailcat-merlin /tmp/tailcat_addr*.txt 2>/dev/null || true
            clear_screen
            printf "\n%b[+] TAILCAT ZER0 has been completely uninstalled.%b\n\n" "$C_GREEN" "$C_RESET"
            exit 0
            ;;
