start_webgui_tunnel() {
    interactive_mode="${1:-1}"
    http_enable=$(nvram get http_enable 2>/dev/null || echo 1)
    [ -z "$http_enable" ] && http_enable=1
    https_port=$(nvram get https_lanport 2>/dev/null || echo 8443)
    [ -z "$https_port" ] && https_port=8443
    http_port=$(nvram get http_lanport 2>/dev/null || echo 80)
    [ -z "$http_port" ] && http_port=80

    if [ "$http_enable" = "0" ]; then
        web_proto="http"
        primary_port="$http_port"
        serve_ports="$http_port"
    else
        web_proto="https"
        primary_port="$https_port"
        serve_ports="${https_port},${http_port}"
    fi

    start_tunnel "WEBGUI" "serve ${serve_ports}" "🌐 Router WebGUI (Port ${primary_port})" "${web_proto}://${primary_port} (Ports: ${serve_ports})" "$interactive_mode"
}

